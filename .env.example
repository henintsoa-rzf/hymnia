# Copy to .env (never committed) and fill in.
# Contact address sent to source sites in the importer's User-Agent
# (specs/002-hymnal-import/research.md, R3). Required for any command that uses the network.
HYMNIA_CONTACT=

# Personal use: 1 publishes every hymn, even those whose rights are not confirmed, in
# `npm run data` / `npm run build`. Only for a copy of the app nobody else uses.
HYMNIA_PERSONAL_USE=

# Search by meaning (specs/011-semantic-search). Mammouth AI key, used by `npm run data`
# and the scripts in scripts/semantic/. On Cloudflare: `npx wrangler secret put MAMMOUTH_API_KEY`.
MAMMOUTH_API_KEY=
# OpenAI-compatible embeddings endpoint (default below).
# EMBEDDINGS_BASE_URL=https://api.mammouth.ai/v1
# Embeddings model; changing it re-embeds every stanza (default below).
# EMBEDDINGS_MODEL=text-embedding-3-large
# Claude API key, only for scripts/semantic/generate-themes.ts (theme descriptions, research R11).
ANTHROPIC_API_KEY=
