# Copy to .env (never committed) and fill in.
# Contact address sent to source sites in the importer's User-Agent
# (specs/002-hymnal-import/research.md, R3). Required for any command that uses the network.
HYMNIA_CONTACT=

# Personal use: 1 publishes every hymn, even those whose rights are not confirmed, in
# `npm run data` / `npm run build`. Only for a copy of the app nobody else uses.
HYMNIA_PERSONAL_USE=
