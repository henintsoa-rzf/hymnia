{
	"id": "a-tes-pieds",
	"title": "À tes pieds",
	"entries": [
		{
			"hymnal": "jem",
			"number": "380"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"À tes pieds, je veux être assis,",
				"Ecouter ta voix divin maître,",
				"Recevoir jour après jour,",
				"De ton amour pour mieux te servir."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Parle-moi, montre-moi",
				"Quelle est ta volonté car je veux t'obéir."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Près de toi, je veux demeurer",
				"Contempler l'œuvre de ta main.",
				"De ton cœur, les sentiments",
				"Je veux avoir pour te ressembler."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Parle-moi, montre-moi",
				"Quelle est ta volonté car je veux t'obéir."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Très bientôt, je serai là-haut,",
				"Face à face avec mon Sauveur.",
				"Et sans fin, j'adorerai",
				"Le Roi des rois, Seigneur des Seigneurs."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Parle-moi, montre-moi",
				"Quelle est ta volonté car je veux t'obéir."
			]
		}
	],
