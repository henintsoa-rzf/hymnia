			"type": "verse",
			"number": 1,
			"lines": [
				"Abba-Père",
				"Nos coeurs t'appelent",
				"Abba-Père",
				"Entends tes ailes",
				"Viens par ta grâce",
				"Que rien ne remplace",
				"Viens nous donner la vie",
				"Dans no faiblesses",
				"Déploie tes tendresses",
				"Viens nous donner ta vie"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Abba-Papa",
				"Mon Dieu, mon Père",
				"Je n'ai que Toi",
				"Dans mes prières",
				"Trace ma route",
				"Efface mes doutes",
				"Donne à ma foi ta paix",
				"Calme mon âme",
				"Ma vie te réclame",
				"Donne à mon coeur sa paix"
			]
		},
