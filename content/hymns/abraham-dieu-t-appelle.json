{
	"id": "abraham-dieu-t-appelle",
	"title": "Abraham, Dieu t’appelle",
	"entries": [
		{
			"hymnal": "arc",
			"number": "767"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Abraham, Dieu t’appelle ;",
				"Abraham, il faut partir.",
				"Il faut prendre la route",
				"Pour avancer dans la foi. (bis)"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Si tu crois, si tu m’écoutes,",
				"Moi, je serai ton ami.",
				"Tu trouveras sur ta route",
				"Le pays que j’ai choisi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Plus nombreux que grains de sable",
				"Sur les rives de la mer,",
				"Vois tes enfants innombrables",
				"Qui peuplent tout l’univers."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Si tu veux me faire confiance",
				"Dans ta vie et dans ton coeur,",
				"Avec toi je fais alliance",
				"Pour que vienne le Sauveur."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Un grand peuple s’est formé,",
				"Comme Dieu l’avait promis ;",
				"Mais quand il est prisonnier,",
				"Moïse se lève et dit :"
			]
		},
		{
			"type": "other",
			"number": null,
			"lines": [
				"R 2 : Lorsque Dieu nous appelle,",
				"Il faut croire, il faut partir.",
				"Il faut prendre la route",
				"Pour avancer dans la foi."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Ils vont quitter l’esclavage,",
				"Marcher de longues années,",
				"Et quand ils perdaient courage,",
				"Les prophètes leur disaient… (R 2)"
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Après beaucoup de souffrances,",
				"Ils ont enfin ce pays",
				"Promis à leur espérance,",
				"Où doit naître le Messie. (R 2)"
			]
		}
	],
