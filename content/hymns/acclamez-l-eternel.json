{
	"id": "acclamez-l-eternel",
	"title": "Acclamez l'Éternel",
	"entries": [
		{
			"hymnal": "jem",
			"number": "723"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Acclamez l'Éternel, bénissez son nom !",
				"Le grand Dieu d'Israël,",
				"puissant en action !",
				"Que tout ce qui respire loue le Seigneur !",
				"Levons-nous pour offrir",
				"l'élan de nos cœurs !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Chantons un cantique nouveau !",
				"Portes élevez vos linteaux !",
				"Qu'apparaisse le Roi de gloire,",
				"Le Seigneur Dieu de victoire !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Acclamez l'Éternel, bénissez son nom !",
				"Le grand Dieu d'Israël,",
				"puissant en action !",
				"Que tout ce qui respire loue le Seigneur !",
				"Levons-nous pour offrir",
				"l'élan de nos cœurs !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Qui s'élèvera vers lui ?",
				"Celui qui trouve un abri,",
				"Dans la force de l'Éternel,",
				"L'amour du Dieu d'Israël."
			]
		},
		{
			"type": "chorus",
