			"number": 1,
			"lines": [
				"Acclamons Jésus,",
				"Acclamons le Seigneur",
				"Roi des rois, Fils de Dieu,",
				"Brillante étoile",
				"Et toute l'éternité,",
				"Je veux te louer",
				"Et je règnerai toujours avec toi."
			]
		}
	],
