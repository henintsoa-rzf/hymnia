{
	"id": "agneau-de-dieu",
	"title": "Agneau de Dieu",
	"entries": [
		{
			"hymnal": "jem",
			"number": "376"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Agneau de Dieu,",
				"qui ôtes le péché du monde.",
				"Agneau de Dieu,",
				"ton pardon, ta grâce abondent.",
				"Tu nous donnes un cœur nouveau.",
				"Nous entrons dans ton repos.",
				"Tu révèles l'amour du Père,",
				"tu répands ta lumière."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Au moment marqué au temps voulu",
				"Jésus-Christ est descendu",
				"Comme le Père l'avait prévu.",
				"Oh d'anciens prophètes l'avaient annoncé",
				"Dieu allait nous visiter",
				"Pour sauver l'humanité."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Agneau de Dieu,",
				"qui ôtes le péché du monde.",
				"Agneau de Dieu,",
				"ton pardon, ta grâce abondent.",
				"Tu nous donnes un cœur nouveau.",
				"Nous entrons dans ton repos.",
				"Tu révèles l'amour du Père,",
				"tu répands ta lumière."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Jésus a connu la mort pour nous.",
				"Il a supporté les coups.",
				"Il nous aima jusqu'au bout.",
				"Oh la mort n'a pourtant pas triomphé.",
				"Ses disciples l'ont attesté,",
				"Jésus est ressuscité !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Agneau de Dieu,",
