		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Vingt siècles ont passé depuis ce cri.",
				"Quand Jésus rendit l'Esprit,",
				"« Voici tout est accompli. »",
				"Oh son amour sauve encore aujourd'hui",
				"Le pécheur qui vient à lui",
				"Repentant, donnant sa vie."
			]
		},
