	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Alléluia, alléluia.",
				"Le Sauveur du monde est là, c’est Jésus.",
				"Alléluia, alléluia.",
				"Au plus grand de tous les noms,",
				"Alléluia."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Les cieux rugissent, les anges chantent !",
				"« À notre Dieu et Roi la gloire ! »",
				"Oh, nuit divine !",
				"Oui pour toujours : Alléluia."
			]
		}
	],
