{
	"id": "alleluia-jem-1138",
	"title": "Alléluia",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1138"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"C’est l’hymne universel,",
				"La mélodie du ciel",
				"Dans tous les siècles, dans tous les temps.",
				"Autour du trône s’élève un chant."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"La création entonne",
				"Ce refrain qui résonne.",
				"Les cieux et la terre se rassemblent",
				"Pour adorer l’Agneau ensemble."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Alléluia, alléluia,",
				"Alléluia, alléluia."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Les peuples et les nations",
				"Sont montés vers Sion",
				"Des quatre coins de l’horizon,",
				"Comme une offrande d’adoration."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Des vieillards aux enfants,",
				"Des petits aux plus grands,",
				"Nous rejoignons le chœur des anges",
				"Dans une symphonie de louange."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Alléluia, alléluia,",
				"Alléluia, alléluia."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Tout genou fléchira,",
				"Toute langue criera :",
				"« Louange au nom de Jésus !"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Il a vaincu l’enfer,",
				"Il a gagné la guerre,",
				"Louange au nom de Jésus !"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Suprême autorité,",
				"Splendeur et majesté,",
				"Louange au nom de Jésus !"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Il a ouvert les cieux,",
				"Le Roi victorieux,",
				"Louange au nom de Jésus !",
				"Louange au nom de Jésus ! »"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Alléluia, alléluia,",
				"Alléluia, alléluia."
			]
		}
	],
