	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Quand mes ennemis me font face",
				"Et que la peur me saisit,",
				"Je chercherai toujours ta face",
				"Car je sais que tu peux agir.",
				"Je chante alléluia, alléluia."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quand mes yeux sont noyés de larmes",
				"Et que sous leur poids je fléchis,",
				"À genoux, je saisis mes armes,",
				"Je te loue, Dieu, tu vas agir.",
				"Je chante alléluia, alléluia."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es Dieu, tout-puissant.",
				"Rien ne t’est impossible,",
				"Oui, je le crois.",
				"Tu es Dieu, toujours présent.",
				"Tu feras l’impossible,",
				"Oui, je le crois."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es Dieu, tout-puissant.",
				"Rien ne t’est impossible,",
				"Oui, je le crois.",
				"Tu es Dieu, toujours présent.",
				"Tu feras l’impossible,",
				"Oui, je le crois.µ",
				"Alléluia, alléluia."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
