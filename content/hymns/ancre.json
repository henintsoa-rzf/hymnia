	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"J'ai cet espoir,",
				"Telle une ancre pour mon âme.",
				"Dans la tempête,",
				"Je m'appuie sur toi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Dans ton amour,",
				"Toutes mes craintes disparaissent.",
				"En toute chose,",
				"J'ai confiance en toi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Mon espoir est assuré, à la croix",
				"Tu as tout donné,",
				"Tu nous as rachetés.",
				"Cet espoir est une ancre pour mon âme.",
				"Inébranlable est notre Dieu."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Dieu éternel,",
				"Tu étais et tu seras.",
				"Tu es fidèle,",
				"Toujours près de moi."
			]
		},
		{
