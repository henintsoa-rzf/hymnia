	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Appliquons-nous à connaître l'Éternel,",
				"Efforçons-nous de connaître notre Dieu.",
				"Sa venue est certaine comme celle du matin.",
				"Il viendra à nous",
				"Comme la pluie du printemps,",
				"Il viendra à nous",
				"Comme l'ondée qui arrose la terre."
			]
		}
	],
