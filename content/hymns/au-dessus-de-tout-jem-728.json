{
	"id": "au-dessus-de-tout-jem-728",
	"title": "Au-dessus de tout",
	"entries": [
		{
			"hymnal": "jem",
			"number": "728"
		},
		{
			"hymnal": "psalmodie",
			"number": "404"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Au-dessus des puissances,",
				"Au-dessus des rois,",
				"Au-dessus de la nature et de la création ;",
				"Au-dessus de tous",
				"Les plans des hommes sages,",
				"Bien avant le monde, tu existais."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Au-dessus des royaumes,",
				"Au-dessus des trônes,",
				"Au-dessus des merveilles",
				"Que ce monde a connues ;",
				"Par dessus tous les trésors de la terre,",
				"Rien ne peut mesurer ta valeur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Crucifié, seul, abandonné,",
				"Tu as souffert méprisé, rejeté,",
				"Telle une rose, foulée par nos pieds,",
				"Tu m'as sauvé, tu m'as aimé",
				"Par dessus tout."
			]
		}
	],
