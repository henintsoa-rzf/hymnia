{
	"id": "au-tribunal-jesus-se-tient",
	"title": "Au tribunal Jésus se tient",
	"entries": [
		{
			"hymnal": "atg",
			"number": "230"
		},
		{
			"hymnal": "adf",
			"number": "493"
		}
