{
	"id": "autant-les-cieux-sont-eleves",
	"title": "Autant les cieux sont élevés",
	"entries": [
		{
			"hymnal": "jem",
			"number": "224"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Autant les cieux sont élevés",
				"au dessus de la terre,",
				"Autant sa bonté est grande",
				"pour ceux qui le craignent.",
				"Autant l'Orient est éloigné de l'Occident,",
				"Autant il éloigne de nous notre transgression."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Comme un père a compassion",
				"de ses enfants,",
				"L'Éternel a compassion",
				"de ceux qui le craignent.",
				"Comme un père a compassion",
				"de ses enfants,",
				"L'Éternel a compassion",
				"de ceux qui le craignent."
			]
		}
	],
