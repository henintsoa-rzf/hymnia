{
	"id": "avec-allegresse",
	"title": "Avec allégresse.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "333"
		},
		{
			"hymnal": "cd",
			"number": "252"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Avec allégresse",
				"Marcher vers le ciel,",
				"Regarder sans cesse",
				"Notre Emmanuel ;",
				"Puiser foi nouvelle",
				"Dans ce doux regard,",
				"De l'âme fidèle,",
				"C'est la sûre part."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Frères, frères, les cœurs en haut !",
				"Jésus nous appelle,",
				"Il viendra bientôt.",
				"Jésus nous appelle,",
				"Il viendra bientôt."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Là, tout est lumière,",
				"Paix et sainteté ;",
				"Là, plus de misère,",
				"Tout est charité !",
				"Sur ce doux rivage",
				"Ont cessé les pleurs ;",
				"Jésus, ton image",
				"Est dans tous les cœurs."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Frères, frères, les cœurs en haut !",
				"Jésus nous appelle,",
				"Il viendra bientôt.",
				"Jésus nous appelle,",
				"Il viendra bientôt."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Amis, bon courage !",
				"L'étoile qui luit",
				"Dissipe l'orage",
				"Et la sombre nuit.",
				"Veillons sur notre âme,",
				"Jésus vient bientôt !",
				"Lui seul nous réclame :",
				"Tous les cœurs en haut !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Frères, frères,",
				"Le ciel est près !",
				"Jésus, Roi de gloire,",
				"Y règne à jamais !",
				"Jésus, Roi de gloire,",
				"Y règne à jamais !"
			]
		}
	],
