	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Que la grâce et la paix du Seigneur",
				"Soient déposées sur vous,",
				"Sur vos cœurs,",
				"Et que sa lumière vienne éclairer vos vies",
				"Par le nom de Jésus-Christ."
			]
		},
