{
	"id": "beni-soit-mon-dieu",
	"title": "Béni soit mon Dieu",
	"entries": [
		{
			"hymnal": "jem",
			"number": "384"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Béni soit mon Dieu",
				"qui porte mes fardeaux,",
				"Qui entend mes prières,",
				"qui me donne le salut.",
				"Béni soit mon Dieu",
				"qui règne dans les cieux,",
				"Qui règne sur la terre,",
				"qui règne dans mon cœur."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu es beau dans ton sanctuaire,",
				"Tu es beau, Seigneur, mon Dieu.",
				"Béni soit mon Dieu, béni soit mon Dieu."
			]
		}
	],
