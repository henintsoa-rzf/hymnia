			"lines": [
				"Bénissez Dieu,",
				"Vous tous serviteurs de Dieu,",
				"Qui vous tenez,",
				"Dans la maison de Dieu,",
				"Levez vos mains,",
				"Vers le lieu très saint,",
				"Bénissez Dieu,",
				"l'Éternel Dieu."
			]
		}
