{
	"id": "brisant-ses-liens-funebres",
	"title": "Brisant ses liens funèbres",
	"entries": [
		{
			"hymnal": "atg",
			"number": "136"
		},
		{
			"hymnal": "adf",
			"number": "119"
		},
		{
			"hymnal": "cd",
			"number": "111"
