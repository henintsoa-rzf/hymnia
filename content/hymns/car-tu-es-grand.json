	"id": "car-tu-es-grand",
	"title": "Car tu es grand",
	"entries": [
		{
			"hymnal": "jem",
			"number": "13"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Car tu es grand,",
				"Et tu opères des prodiges ;",
				"Toi seul, tu es Dieu.",
				"Enseigne-moi tes voies ;",
				"O Éternel ! je marcherai dans ta fidélité.",
				"Dispose mon cœur à la crainte de ton nom.",
				"Je te louerai de tout mon cœur,",
				"Seigneur, mon Dieu !"
			]
		}
	],
