	"title": "Car un enfant nous est né",
	"entries": [
		{
			"hymnal": "jem",
			"number": "26"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Car un enfant nous est né,",
				"Un fils nous est donné,",
				"Et la domination reposera sur son épaule.",
				"On l'appellera Admirable,",
				"Conseiller, Dieu puissant,",
				"Père éternel, Prince de la paix."
			]
		},
