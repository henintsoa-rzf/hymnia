{
	"id": "ce-nom-si-merveilleux",
	"title": "Ce nom si merveilleux",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1079"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu étais là dès la création,",
				"Fils unique du Dieu très haut,",
				"Les mystères de ta gloire révélés",
				"En toi Christ notre Seigneur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! ce nom est si merveilleux !",
				"Oh ! ce nom est si merveilleux !",
				"Le nom de Jésus-Christ mon Roi,",
				"Oh ! ce nom est si merveilleux !",
				"Sa beauté est sans pareille.",
				"Oh ! ce nom est si merveilleux,",
				"Le nom de Jésus."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu n'as pas voulu les cieux sans nous,",
				"Alors, Jésus, tu es venu.",
				"Ton amour a vaincu mon péché,",
				"Rien ne peut nous séparer."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! ce nom est si glorieux !",
				"Oh ! ce nom est si glorieux !",
				"Le nom de Jésus-Christ mon Roi,",
				"Oh ! ce nom est si glorieux !",
				"Sa beauté est sans pareille.",
				"Oh ! ce nom est si glorieux,",
				"Le nom de Jésus."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"La terre a tremblé,",
				"Le voile s'est déchiré,",
				"Désarmant la mort et le péché.",
				"Les cieux chantent ta gloire,",
				"L'écho de ta victoire,",
				"Car tu es le Roi ressuscité."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Tu es sans rival,",
				"Tu es sans égal.",
				"Dieu, tu triomphes à tout jamais.",
				"À toi soit le règne,",
				"À toi soit la gloire,",
				"Ton nom surpasse tout autre nom."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! ce nom est victorieux !",
				"Oh ! ce nom est victorieux !",
				"Le nom de Jésus-Christ mon Roi,",
				"Oh ! ce nom est victorieux !",
				"Sa puissance est sans pareille.",
				"Oh ! ce nom est victorieux,",
				"Le nom de Jésus."
			]
		}
	],
