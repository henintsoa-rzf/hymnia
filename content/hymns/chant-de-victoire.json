	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Avec Dieu, nous ferons des exploits",
				"Car c'est lui seul qui écrase l'ennemi,",
				"Chantons et crions la victoire:",
				"Christ est Roi !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Car Dieu a gagné le combat",
				"Et libéré son peuple.",
				"Sa Parole a vaincu l'ennemi,",
				"La terre entière verra qu'avec"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu, nous ferons des exploits",
				"Car c'est lui seul qui écrase l'ennemi,",
				"Chantons et crions la victoire:",
				"Christ est Roi !",
				"Christ est Roi !",
				"Christ est Roi ! Hé !"
			]
		}
