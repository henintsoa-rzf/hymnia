{
	"id": "chante-mon-coeur",
	"title": "Chante, mon coeur",
	"entries": [
		{
			"hymnal": "arc",
			"number": "705"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Chante, mon coeur,",
				"Chante ta joie !",
				"Crie le Seigneur,",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dieu vient chasser toutes nos peurs,",
				"Il nous réjouit de sa joie.",
				"L’enfant Dieu fait chanter mon coeur,",
				"Il reviendra, Maranatha !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Je veux sans cesse le chanter,",
				"Ce Dieu qui brise ma tristesse.",
				"Je lui confiai ma pauvreté ;",
				"Ce fut ma source de richesse…"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Et tous les filets ont craqué,",
				"Craqué de joies et de chansons ;",
				"Goûtons le pain de liberté,",
				"Arrive l’heure des moissons…"
			]
		}
	],
