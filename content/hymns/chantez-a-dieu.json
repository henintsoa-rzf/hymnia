{
	"id": "chantez-a-dieu",
	"title": "Chantez à Dieu",
	"entries": [
		{
			"hymnal": "arc",
			"number": "96"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Chantez à Dieu strophe nouvelle !",
				"Chantez, ô terre universelle !",
				"Bénissez Dieu de jour en jour",
				"Et que chacun vienne à son tour",
				"Acclamer sa gloire immortelle."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"On entendra sous son empire",
				"Les cieux chanter, la terre rire,",
				"Tonner l’océan écumeux",
				"Et les champs, les bois avec eux,",
				"Ses louanges dire et redire."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Le Seigneur vient, il va paraître.",
				"Il vient à nous, lui le seul maître,",
				"Le juge saint, plein d’équité",
				"Et partout sa fidélité",
				"Aux peuples se fera connaître."
			]
		}
	],
