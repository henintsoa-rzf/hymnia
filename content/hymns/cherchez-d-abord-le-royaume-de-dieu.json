	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Cherchez d'abord le royaume de Dieu,",
				"Et sa justice",
				"Et toutes ces choses",
				"vous seront données en plus :",
				"Allélu, Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"L'homme ne vivra pas de pain seulement,",
				"Mais de toute parole",
				"Qui sortira de la bouche de Dieu :",
				"Allélu, Alléluia !"
			]
		}
	],
