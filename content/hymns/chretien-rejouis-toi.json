{
	"id": "chretien-rejouis-toi",
	"title": "Chrétien, réjouis-toi !",
	"entries": [
		{
			"hymnal": "atg",
			"number": "341"
		},
		{
			"hymnal": "jem",
			"number": "91",
			"title": "Réjouis-toi"
		},
		{
			"hymnal": "cd",
			"number": "293",
			"title": "Réjouis-toi !"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Chrétien, réjouis-toi !",
				"Tressaille d'allégresse,",
				"Car ton Sauveur est Roi :",
				"Regarde à lui sans cesse."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"En son amour, chrétien, réjouis-toi,",
				"réjouis-toi toujours !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Exalte le Seigneur :",
				"Il a sauvé ton âme.",
				"Dieu l'a comblé d'honneur",
				"Après la croix infâme."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"En son amour, chrétien, réjouis-toi,",
				"réjouis-toi toujours !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Éclate en saints transports !",
				"Voici : ton Dieu confie",
				"Les portes de la mort",
				"Au Prince de la vie."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"En son amour, chrétien, réjouis-toi,",
				"réjouis-toi toujours !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Espère, adore et crois !",
				"Jésus seul est le Maître :",
				"Au loin déjà je vois",
				"Sa gloire enfin paraître."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"En son amour, chrétien, réjouis-toi,",
				"réjouis-toi toujours !"
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Christ règne dans le ciel",
				"Au sein de la lumière,",
				"Et son règne éternel",
				"Bientôt viendra sur terre."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"En son amour, chrétien, réjouis-toi,",
				"réjouis-toi toujours !"
			]
		}
	],
