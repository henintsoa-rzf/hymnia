		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Christ est ressuscité,",
				"De la mort a triomphé.",
				"Réjouissons-nous en ce jour,",
				"Christ vivant l’est pour toujours.",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C’est pour l’éternité",
				"Que Jésus a triomphé.",
				"Célébrons le Père et le Fils",
				"Dans l’unité de l’Esprit.",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Alléluia ! Alléluia !",
				"Alléluia !",
				"Réjouissons-nous en ce jour,",
				"Christ vivant l’est pour toujours.",
				"Alléluia !"
			]
		}
	],
