{
	"id": "christ-est-victorieux",
	"title": "Christ est victorieux",
	"entries": [
		{
			"hymnal": "ecriture",
			"number": "14"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Le jour a éclaté,",
				"Les ténèbres fuient.",
				"La pierre est écartée :",
				"Notre Seigneur vit !",
				"S’achève notre attente :",
				"Voici qu’il inspire.",
				"La mort est impuissante",
				"Pour le retenir !"
			]
		},
		{
			"type": "other",
			"number": null,
			"lines": [
				"En un instant tout a changé,",
				"En vainqueur il s’est relevé !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! Christ est victorieux,",
				"Couronné dans les cieux !",
				"Ô Mort, où est ton pouvoir ?",
				"Ô Enfer, où est ta victoire ?",
				"Il règne triomphant,",
				"Pour la durée des temps !",
				"Le joug du péché brisé,",
				"Les ténèbres sont renversées."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"La dette est acquittée,",
				"La peine est servie,",
				"L’esclave libéré :",
				"Notre Seigneur vit !",
				"L’élan de son Esprit,",
				"En nous insufflé,",
				"Nous relève avec lui,",
				"Vient nous transformer !"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Son royaume est inauguré",
				"Et ne pourra être ébranlé !",
				"Il emmène vers sa cité",
				"Un cortège de rachetés !"
			]
		}
	],
