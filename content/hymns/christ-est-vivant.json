		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Alléluia ! Alléluia ! Alléluia !",
				"Christ est vivant ! Sublime nouvelle :",
				"Il a vaincu la tombe cruelle,",
				"Et nous acquit la vie éternelle.",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Alléluia ! Alléluia ! Alléluia !",
				"Christ est vivant ! Ce cri de victoire",
				"A transformé le cours de l’histoire,",
				"Et de la croix il chante la gloire.",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Alléluia ! Alléluia ! Alléluia !",
				"Christ est vivant ! Ô sainte allégresse :",
				"Il reviendra, telle est sa promesse,",
				"Et nous vivrons avec lui sans cesse.",
				"Alléluia !"
			]
		}
	],
