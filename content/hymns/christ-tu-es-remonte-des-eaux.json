	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Christ, tu es remonté des eaux",
				"Au jour de ton baptême.",
				"Avec toi le monde est sauvé,",
				"Ce monde que tu aimes.",
				"Le ciel fermé s’ouvre pour nous,",
				"L’Esprit descend sur terre.",
				"La voix du Père a retenti :",
				"“Voici le Fils que j’aime ;",
				"Ecoutez sa parole”."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"L’Eglise reçoit ses enfants",
				"De toute race humaine.",
				"L’eau du baptême et l’Esprit Saint",
				"Au peuple les agrègent.",
				"O toi, Saint-Esprit créateur,",
				"Par toi naît la prière ;",
				"Tu fais surgir du vieux limon",
				"Les fils de la lumière ;",
				"C’est toi qui les baptises."
			]
		}
	],
