{
	"id": "comme-l-eau-d-un-ruisseau",
	"title": "Comme l'eau d'un ruisseau",
	"entries": [
		{
			"hymnal": "jem",
			"number": "564"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Comme l'eau d'un ruisseau,",
				"Ta présence coule en moi.",
				"Comme un courant d'eau,",
				"Ta paix remplit mon cœur.",
				"Ta confiance m'inonde,",
				"Ta présence me remplit.",
				"Ton Esprit est là, je n'en doute pas.",
				"Me laissant bercer par tes vagues d'amour,",
				"Je suis emporté dans ton courant."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Je viens, je viens vers toi, mon Père.",
				"Je viens, je viens vers toi, Papa.",
				"Tel que je suis, je viens vers toi",
				"Pour me blottir dans tes bras d'amour.",
				"Tes bras d'amour."
			]
		}
	],
