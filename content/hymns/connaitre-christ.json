{
	"id": "connaitre-christ",
	"title": "Connaître Christ",
	"entries": [
		{
			"hymnal": "ecriture",
			"number": "13"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon cher désir : connaître Christ,",
				"En qui j’ai gagné la justice.",
				"Ce don de Dieu, précieux trésor,",
				"Éclipse tous mes vains efforts."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ma pleine joie : connaître Christ,",
				"En qui mon âme est affermie.",
				"Dans l’abondance ou la douleur,",
				"Sa paix viendra garder mon cœur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Jésus, je veux te connaître,",
				"Toi, mon bien suprême,",
				"Illumine mon esprit !",
				"Que mon âme émerveillée",
				"En toi seul soit comblée,",
				"Car tu es ma vie !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Je veux grandir en sainteté,",
				"À Jésus être conformé,",
				"En communiant à ses souffrances,",
				"Être changé par sa puissance."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Je veux courir, saisir le prix",
				"Pour lequel Jésus m’a saisi.",
				"Ma foi enfin récompensée",
				"Quand de mes yeux je le verrai !"
			]
		}
	],
