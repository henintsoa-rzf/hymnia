{
	"id": "dans-l-abime-de-misere",
	"title": "Dans l'abîme de misère.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "197"
		},
		{
			"hymnal": "adf",
			"number": "197A"
		},
		{
			"hymnal": "cd",
			"number": "302"
