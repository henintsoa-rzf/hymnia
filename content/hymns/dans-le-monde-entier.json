{
	"id": "dans-le-monde-entier",
	"title": "Dans le monde entier",
	"entries": [
		{
			"hymnal": "jem",
			"number": "167"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dans le monde entier,",
				"Le Saint-Esprit agit,",
				"Dans le monde entier,",
				"Comme le prophète l'a dit.",
				"Dans le monde entier,",
				"Le Seigneur répand sa gloire",
				"Remplissant tout l'univers,",
				"Comme l'eau couvre le fond des mers."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Au fond de mon cœur,",
				"Le Saint-Esprit agit,",
				"Au fond de mon cœur,",
				"Comme le prophète l'a dit.",
				"Au fond de mon cœur,",
				"Le Seigneur répand sa gloire",
				"Remplissant mon cœur ouvert,",
				"Comme l'eau, couvre le fond des mers."
			]
		}
	],
