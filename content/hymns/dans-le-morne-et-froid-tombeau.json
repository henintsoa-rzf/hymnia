{
	"id": "dans-le-morne-et-froid-tombeau",
	"title": "Dans le morne et froid tombeau.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "121"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dans le morne et froid tombeau",
				"Descend le Prince de vie ;",
				"Le jour éteint son flambeau,",
				"La mort triomphe, assouvie."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C'en est fait : Il est vaincu !",
				"Scellez ces pierres funèbres !",
				"Toute lumière a vécu,",
				"L'avenir est aux ténèbres !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Quoi, Seigneur, serait-il vrai ?",
				"Ah ! plutôt que de le croire",
				"Avec toi je descendrai",
				"Dans la nuit profonde et noire"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Car tu ne mourus ainsi",
				"Que pour me frayer la voie.",
				"À moi, de mourir aussi",
				"Au monde, à sa folle joie !"
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Je meurs ! Mais quelle clarté",
				"Me ravit et me pénètre ?",
				"Jésus est ressuscité,",
				"Par lui je me sens renaître !"
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Que mon âme, ô divin Roi,",
				"T'adore et te glorifie,",
				"Car, en mourant avec toi,",
				"Elle a retrouvé la vie !"
			]
		}
	],
	"credits": [
		{
