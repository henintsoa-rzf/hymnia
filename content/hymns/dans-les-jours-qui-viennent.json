	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dans les jours qui viennent,",
				"Et quoi qu'il advienne,",
				"Dieu vous maintienne",
				"À jamais en paix.",
				"Que par vos prières,",
				"Votre vie entière",
				"Soit à sa lumière,",
				"À jamais en paix."
			]
		}
	],
