	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dans sa gloire, notre Maître",
				"Bientôt va paraître.",
				"Oui, bientôt nous allons être",
				"Avec lui, dans les cieux."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Du sauveur qui nous donne",
				"La paix, et nous pardonne,",
				"Nous serons la couronne,",
				"Les joyaux précieux."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tous ceux qui surent entendre",
				"Sa voix douce et tendre,",
				"Le Seigneur viendra les prendre",
				"Avec lui, dans les cieux."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Du sauveur qui nous donne",
				"La paix, et nous pardonne,",
				"Nous serons la couronne,",
				"Les joyaux précieux."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Vous qui recevez sa grâce",
				"Et suivez sa trace,",
				"Il vous prépare une place",
				"Près de lui, dans les cieux."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Du sauveur qui nous donne",
				"La paix, et nous pardonne,",
				"Nous serons la couronne,",
				"Les joyaux précieux."
			]
		}
	],
