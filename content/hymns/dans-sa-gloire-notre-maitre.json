{
	"id": "dans-sa-gloire-notre-maitre",
	"title": "Dans sa gloire, notre Maître",
	"entries": [
		{
			"hymnal": "atg",
			"number": "148"
		},
		{
			"hymnal": "adf",
			"number": "135"
		},
		{
			"hymnal": "cd",
			"number": "120"
