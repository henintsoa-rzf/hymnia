	"title": "De Béthléem à Golgotha",
	"entries": [
		{
			"hymnal": "jem",
			"number": "126"
		}
	],
	"sections": [
		{
			"type": "other",
			"number": null,
			"lines": [
				"De Bethléem à la croix,",
				"De la crèche à Golgotha,",
				"De ma misère à ma joie,",
				"Il n'y a que Jésus."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"O Jésus ton amour,",
				"oui, ton amour pour moi,",
				"Est si grand qu'il remplit tout mon cœur.",
				"O Jésus ton amour,",
				"oui, ton amour pour moi,",
				"Est si grand qu'il me remplit de bonheur."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Cet amour qu'il m'a donné",
				"O je voudrais le partager.",
				"Ne veux-tu pas l'accepter",
				"Et avec moi chanter."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"O Jésus ton amour,",
				"oui, ton amour pour moi,",
				"Est si grand qu'il remplit tout mon cœur.",
				"O Jésus ton amour,",
				"oui, ton amour pour moi,",
				"Est si grand qu'il me remplit de bonheur."
			]
		}
	],
