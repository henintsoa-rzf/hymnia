			"number": 1,
			"lines": [
				"De mon Seigneur",
				"J'aurai la grâce",
				"De chercher encore",
				"Ses vastes desseins",
				"De mon Seigneur",
				"J'aurai la force",
				"De marcher encore",
				"Sur le même chemin"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"De mon Jésus",
				"J'aurai l'amour",
				"La nuit, le jour",
				"Et jusqu'au bout du matin",
				"De mon Jésus",
				"J'aurai toujours",
				"Le doux secours",
				"De sa tendre main"
			]
		}
	],
