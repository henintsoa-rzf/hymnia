{
	"id": "descends-sur-nous",
	"title": "Descends sur nous",
	"entries": [
		{
			"hymnal": "exo",
			"number": "26"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Du sein de notre Dieu",
				"De l'infini des cieux",
				"Descend de son saint lieu sur nous",
				"Le flot de son amour",
				"Que tant de paix entoure",
				"De bienveillance",
				"Et de grâce envers nous"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Et là pour l'adorer",
				"Nos coeurs émerveillés",
				"Reçoivent en sa bonté la joie",
				"De vivre en son alliance",
				"Au puits de sa présence",
				"Des sources inépuisables",
				"De sa voix"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Viens nous combler de toi",
				"Viens couronner de foi",
				"Notre espérance",
				"Descends sur nous",
				"Ô Dieu de Gloire"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Viens partager ta vie",
				"Qu'au chant de ton Esprit",
				"Nos coeurs répandent aussi ton nom",
				"Qu'ils parlent et qu'ils s'épanchent",
				"Qu'ils s'ouvrent et qu'ils se penchent",
				"Sur les eaux",
				"Immuables du pardon"
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Que tous ensemble ainsi",
				"Devant toi réunis",
				"Nous recevions cette huile sainte",
				"Bonne et abondante",
				"Pure et bienfaisante",
				"Ordonnace éternelle",
				"De ta main"
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Ô Dieu de Gloire"
			]
		}
	],
