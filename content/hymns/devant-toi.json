{
	"id": "devant-toi",
	"title": "Devant toi",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1039"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Nous venons devant toi",
				"pour sanctifier ton nom.",
				"Nous venons devant toi implorer ton pardon.",
				"Le cœur reconnaissant,",
				"nous proclamons ta gloire,",
				"Le cœur reconnaissant,",
				"nous chantons ta victoire."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Lève ta lumière et brille sur la terre,",
				"Donne-nous de voir que tout est accompli.",
				"Et tu nous appelles à briller dans le ciel",
				"Comme des étoiles que toi-même tu fais luire."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Nous voici devant toi",
				"Ici et maintenant",
				"Embrasés, tu es le Dieu vivant.",
				"Nous étions prisonniers,",
				"Nous voici libérés, relevés.",
				"Tu es le Dieu présent."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Wow ! oh ! oh ! oh ! oh !",
				"Wow ! oh ! oh ! oh ! oh !",
				"Wow ! oh ! oh !",
				"Oh ! oh ! oh ! oh ! oh !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Nous venons devant toi",
