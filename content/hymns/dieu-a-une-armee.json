			"number": "398"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dieu a une armée qui se lève",
				"Pour lui obéir",
				"Dieu a une armée qui se lève",
				"Pour le servir"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Peuple de Dieu, lève tes mains",
				"Pour l'adorer ;",
				"Peuple de Dieu ouvre ta bouche ;",
				"Dieu veut parler."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C'est l'Esprit de Dieu qui la mène,",
				"Qui mène ses pas.",
				"C'est l'Esprit de Dieu",
				"Qui l'entraîne, l'entraîne au combat."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Peuple de Dieu, lève tes mains",
				"Pour l'adorer ;",
				"Peuple de Dieu ouvre ta bouche ;",
				"Dieu veut parler."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"À l'Agneau de Dieu soit la gloire",
				"Dans les lieux très hauts.",
				"À l'Agneau de Dieu la victoire,",
				"Vive notre héros."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Peuple de Dieu, lève tes mains",
