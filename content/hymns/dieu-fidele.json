{
	"id": "dieu-fidele",
	"title": "Dieu fidèle",
	"entries": [
		{
			"hymnal": "jem",
			"number": "612"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu fidèle, tu ne changes pas ;",
				"Éternel, mon rocher, ma paix,",
				"Dieu puissant, je m'appuie sur toi",
				"Et je crie vers toi,",
				"Car tu es mon Dieu,",
				"Oui, je crie vers toi,",
				"J'ai besoin de toi."
			]
		},
		{
