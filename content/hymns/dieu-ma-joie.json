{
	"id": "dieu-ma-joie",
	"title": "Dieu, ma joie",
	"entries": [
		{
			"hymnal": "arc",
			"number": "708"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dieu, ma joie,",
				"Dieu, mon bonheur,",
				"Dieu, mon allégresse,",
				"Je te chante",
				"Alléluia, Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Dieu très beau,",
				"Dieu de clarté,",
				"Dieu toute lumière,",
				"Je te chante",
				"Alléluia, Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Dieu très grand,",
				"Dieu tout puissant,",
				"Dieu de gloire immense,",
				"Je te chante",
				"Alléluia, Alléluia !"
			]
		}
	],
