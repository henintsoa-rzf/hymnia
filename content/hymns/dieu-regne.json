{
	"id": "dieu-regne",
	"title": "Dieu règne",
	"entries": [
		{
			"hymnal": "jem",
			"number": "309"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu règne ! Monde, sois dans la joie,",
				"Vous, collines, chantez !",
				"Vous, les arbres, élevez les mains,",
				"Terre, écoute sa voix !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Faites un bruit joyeux",
				"au Seigneur de la terre,",
				"Eclatez en un chant nouveau.",
				"Vous, les fils de Dieu, révélez sa lumière,",
				"Votre salut paraîtra bientôt."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu règne ! Vous, nations voyez:",
				"Le Seigneur est le Roi des rois.",
				"Terre tremble, car le Seigneur est grand",
				"Et son règne est puissant."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Appelez les peuples de la terre vers lui,",
				"Fléchissez les genoux et priez,",
				"Car Dieu est saint, sa force est infinie,",
				"Il ne nous délaissera jamais."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu règne ! Monde, sois dans la joie,",
				"Vous, collines, chantez !",
				"Vous, les arbres, élevez les mains,",
				"Terre, écoute sa voix !"
			]
		}
	],
