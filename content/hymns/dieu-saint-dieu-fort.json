				"Dieu saint, Dieu fort, Dieu immortel,",
				"Béni soit ton nom !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ciel et terre sont remplis de ta gloire."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Béni soit celui qui vient au nom du Seigneur !"
			]
		}
	],
