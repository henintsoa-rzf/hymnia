	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Divine Parole",
				"Qui soutiens ma foi,",
				"Ta clarté console,",
				"Viens briller en moi.",
				"Lorsqu'un voile sombre",
				"S'étend sur mon cœur,",
				"Tu dissipes l'ombre,",
				"D'un rayon vainqueur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Divine Parole",
				"Qui soutiens ma foi,",
				"Ta clarté console,",
				"Viens briller en moi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Message si tendre",
				"Du Sauveur en croix,",
				"Qu'il est doux d'entendre",
				"Ces mots : « Viens et crois ! »",
				"Par son sacrifice,",
				"Ineffable don,",
				"Le Dieu de justice",
				"Donne son pardon."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Divine Parole",
				"Qui soutiens ma foi,",
				"Ta clarté console,",
				"Viens briller en moi."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Que ce triste monde",
				"T'écoute en tout lieu,",
				"O Bible, et réponde",
				"À l'appel de Dieu !",
				"Que toute âme humaine",
				"Par toi trouve enfin,",
				"En brisant sa chaîne,",
				"Le bonheur sans fin !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Divine Parole",
				"Qui soutiens ma foi,",
				"Ta clarté console,",
				"Viens briller en moi."
			]
		}
	],
