	"id": "donne-seigneur",
	"title": "Donne, Seigneur",
	"entries": [
		{
			"hymnal": "atg",
			"number": "220"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Donne, Seigneur, paix et grâce ;",
				"Donne ta paix à celui qui vient à toi.",
				"Ta paix qui surpasse",
				"La paix, la joie que nous connaissons.",
				"Donne-nous, dans ta grâce,",
				"Ta paix, ta joie, nous t'en prions."
			]
		}
	],
