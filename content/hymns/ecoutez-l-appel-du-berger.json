{
	"id": "ecoutez-l-appel-du-berger",
	"title": "Écoutez l'appel du Berger",
	"entries": [
		{
			"hymnal": "atg",
			"number": "376"
		},
		{
			"hymnal": "adf",
			"number": "346"
		},
		{
			"hymnal": "cd",
