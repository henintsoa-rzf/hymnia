{
	"id": "el-olam",
	"title": "El Olam",
	"entries": [
		{
			"hymnal": "jem",
			"number": "617"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"D'âge en âge, tu es Dieu,",
				"Ma seule sécurité.",
				"Avant que les montagnes soient nées,",
				"Avant que le monde fut créé,"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"El Olam, Dieu Éternel,",
				"Tu existes depuis toujours,",
				"Dieu vivant !",
				"El Olam, Dieu Éternel,",
				"toi qui étais, qui es, qui seras."
			]
		}
	],
