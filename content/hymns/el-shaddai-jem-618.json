{
	"id": "el-shaddai-jem-618",
	"title": "El Shaddaï",
	"entries": [
		{
			"hymnal": "jem",
			"number": "618"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"El Shaddaï, El Shaddaï,",
				"Dieu nourrit, rassasie.",
				"Dieu Tout-puissant,",
				"Tout-suffisant,",
				"Plein de bonté, d'autorité."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu, tu fortifies ton peuple.",
				"Comme un père et une mère, tu me nourris.",
				"Tu m'appelles « mon enfant ».",
				"Ravis de ton regard, je vis",
				"El Shaddaï.",
				"Tu donnes vie, El Shad daï."
			]
		}
	],
