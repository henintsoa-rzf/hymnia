			"lines": [
				"Seou shearim rasheichem",
				"Ve yavo melech hakavod !",
				"Seou shearim rasheichem",
				"Ve yavo melech hakavod !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Mi hou zeh melech hakavod ?",
				"Adonaï tsevaot !",
				"Mi hou zeh melech hakavod ?",
				"Adonaï tsevaot !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
