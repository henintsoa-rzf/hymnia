	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Qui suis-je pour que le Roi des Cieux",
				"M’ouvre ses bras ?",
				"Perdu, mais trouvé par sa grâce,",
				"Son amour pour moi,",
				"Son amour pour moi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il m’a libéré,",
				"Ma dette est payée.",
				"Je suis enfant de Dieu,",
				"Je suis à lui."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Il m’a racheté à la croix,",
				"Grâce insondable.",
				"J’étais esclave du péché,",
				"Mais il m’a sauvé.",
				"Jésus m’a sauvé."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il m’a libéré,",
				"Ma dette est payée.",
				"Je suis enfant de Dieu,",
				"Je suis à lui.",
				"Et dans sa maison,",
				"J’ai trouvé ma place.",
				"Je suis enfant de Dieu,",
				"Je suis à lui."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Je suis choisi et affranchi.",
				"En toi je sais qui je suis.",
				"Tu es pour moi,",
				"Pas contre moi,",
				"En toi, je sais qui je suis."
			]
		},
