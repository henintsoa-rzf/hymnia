		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Jésus, encore plus de toi,",
				"De ton onction et de ta compassion.",
				"Jésus, encore plus de toi,",
				"De ta puissance et de ta présence.",
				"Je désire faire la différence",
				"Dans ce monde sans espérance.",
				"Jésus, encore plus de toi."
			]
		}
	],
