	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Entends, ô Dieu,",
				"Ma prière et mon cri.",
				"Du bout de la terre,",
				"Je crie à toi, Seigneur,",
				"Et quand mon cœur est abattu,",
				"Conduis-moi sur le roc",
				"Trop élevé pour moi ;",
				"Trop élevé pour moi."
			]
		}
	],
