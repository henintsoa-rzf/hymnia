{
	"id": "esprit-de-dieu",
	"title": "Esprit de Dieu",
	"entries": [
		{
			"hymnal": "jem",
			"number": "753"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Esprit de Dieu, viens comme un souffle,",
				"une flamme ;",
				"Esprit de Dieu, viens déployer",
				"ta force en nous. (moi)"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens, Esprit saint,",
				"Viens, Esprit saint,",
				"Viens, Esprit saint,",
				"Viens, Esprit saint."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Esprit de Dieu, viens, ouvre nos yeux,",
				"nos oreilles ;",
				"Esprit de Dieu, viens,",
				"parle-nous dans ta douceur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens, Esprit saint,",
				"Viens, Esprit saint,",
				"Viens, Esprit saint,",
				"Viens, Esprit saint."
			]
		}
	],
