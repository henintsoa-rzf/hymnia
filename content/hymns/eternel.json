{
	"id": "eternel",
	"title": "Éternel",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1182"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Devant le grand Dieu d’Israël,",
				"Devant le créateur du ciel,",
				"Devant celui qui est, qui était et qui vient,",
				"Devant lui, élevons nos mains."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Devant le grand Dieu d’Abraham,",
				"Devant le gardien de nos âmes,",
				"Notre Père à jamais,",
				"Notre Dieu pour toujours,",
				"Devant lui, chantons son amour."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il est l’Éternel, Éternel.",
				"Il est l’Éternel, Éternel"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Devant ce Dieu qui, d’âge en âge,",
				"Confond les puissants et les sages,",
				"Souverain doux et tendre",
				"Et Seigneur tout-puissant.",
				"Inclinons-nous, reconnaissants."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il est l’Éternel, Éternel.",
				"Il est l’Éternel, Éternel"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Devant le Dieu de l’univers,",
				"Devant ce Roi qui s'est offert,",
				"Devant notre Sauveur qui règne pour toujours,",
				"Louons, célébrons son amour."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il est l’Éternel, Éternel.",
				"Il est l’Éternel, Éternel"
			]
		}
	],
