			"number": 1,
			"lines": [
				"Étranger sur la terre,",
				"Je marche avec bonheur",
				"Vers la maison du Père,",
				"Vers la maison où m'attend le Seigneur,",
				"Vers la maison du Père,",
				"Vers la maison où m'attend le Seigneur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! quand sera-ce",
				"Que, face à face,",
				"Pour toujours près de toi,",
				"Je te verrai, mon Roi !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C'est là qu'au chœur des anges,",
