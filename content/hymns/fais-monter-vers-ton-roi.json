{
	"id": "fais-monter-vers-ton-roi",
	"title": "Fais monter vers ton Roi",
	"entries": [
		{
			"hymnal": "jem",
			"number": "409"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Fais monter vers ton Roi",
				"Des clameurs de joie.",
				"Que ta voix s'élève et chante alléluia.",
				"Viens te prosterner",
				"Devant sa majesté.",
				"Entre joyeusement",
				"Dans la présence de Dieu."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu m'as donné la vie.",
				"Tu as payé le prix,",
				"Et tu m'as affranchi toi, Seigneur,",
				"Celui qui me guérit.",
				"Toi seul me rassasies,",
				"Car tu es le berger de ma vie.",
				"Je t'adore, mon Seigneur, mon Roi."
			]
		}
	],
