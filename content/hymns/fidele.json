			"type": "verse",
			"number": 1,
			"lines": [
				"Tes bontés se renouvellent",
				"Chaque jour, chaque saison",
				"Pour ceux qui te cherchent et craignent",
				"La splendeur de ton saint nom.",
				"Tes bontés se renouvellent",
				"Chaque jour, chaque saison",
				"Pour ceux qui te cherchent et craignent",
				"La splendeur de ton saint nom."
			]
		},
		{
