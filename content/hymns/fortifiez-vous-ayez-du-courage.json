{
	"id": "fortifiez-vous-ayez-du-courage",
	"title": "Fortifiez-vous, ayez du courage",
	"entries": [
		{
			"hymnal": "jem",
			"number": "20"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Fortifiez-vous, ayez du courage !",
				"Ne craignez point, ne soyez point effrayés ;",
				"Car l'Éternel, ton Dieu,",
				"Marchera lui-même avec toi,",
				"Il ne te délaissera point,",
				"Il ne t'abandonnera point."
			]
		}
	],
