	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Gémissant sous l'esclavage,",
				"Dans la sombre nuit,",
				"Amis, reprenez courage :",
				"Déjà l'aube luit."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! joyeuse espérance !",
				"Voici la délivrance !",
				"Nous connaissons la puissance",
				"De notre grand Libérateur,",
				"Et nous vous disons : Confiance !",
				"Venez, donnez-Lui votre cœur !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Que de larmes, que de chutes",
				"Dans la sombre nuit !",
				"Voici la fin de vos luttes :",
				"Déjà l'aube luit."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! joyeuse espérance !",
				"Voici la délivrance !",
				"Nous connaissons la puissance",
				"De notre grand Libérateur,",
				"Et nous vous disons : Confiance !",
				"Venez, donnez-Lui votre cœur !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Prenant en dégoût la vie,",
				"cœurs découragés !",
				"Que pourrait votre énergie,",
				"Pauvres naufragés ?"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! joyeuse espérance !",
				"Voici la délivrance !",
				"Nous connaissons la puissance",
				"De notre grand Libérateur,",
				"Et nous vous disons : Confiance !",
				"Venez, donnez-Lui votre cœur !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Sans cesse à nouveau vaincue",
				"Dans la sombre nuit,",
				"Votre pauvre âme abattue",
				"Ne croit plus en Lui…"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! joyeuse espérance !",
				"Voici la délivrance !",
				"Nous connaissons la puissance",
				"De notre grand Libérateur,",
				"Et nous vous disons : Confiance !",
				"Venez, donnez-Lui votre cœur !"
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Lui, qui fit tomber nos chaînes",
				"Et nous affranchit,",
				"Voit aussi vos luttes vaines",
				"Dans la sombre nuit…"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! joyeuse espérance !",
				"Voici la délivrance !",
				"Croyez donc à la puissance",
				"De notre grand Libérateur,",
				"Et venez avec confiance ;",
				"Venez, donnez-Lui votre cœur !"
			]
		}
	],
