{
	"id": "gemissant-sous-l-esclavage",
	"title": "Gémissant sous l'esclavage.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "210"
		},
		{
			"hymnal": "cd",
			"number": "196"
		}
