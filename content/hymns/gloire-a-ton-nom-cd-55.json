				"Je veux te rendre grâces:",
				"Un jour tu m'as sorti",
				"De la fosse éternelle",
				"Que je creusais moi même."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire à ton nom Seigneur Jésus",
				"Gloire à ton nom Éternel."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Je veux te rendre grâces",
				"Pour ta source de paix.",
				"Elle a jailli un jour",
				"Du profond de mon âme."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Je veux te rendre grâces",
				"Pour toutes les épreuves.",
				"Elles purifient ma foi",
				"Et me façonne à toi."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Je veux te rendre grâce:",
				"Ton Esprit me fait croître",
				"Comme un grand arbre en fruits",
				"Au milieu de la mort."
			]
		}
	],
