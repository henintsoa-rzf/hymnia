{
	"id": "gloire-honneur",
	"title": "Gloire, honneur",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1078"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon cœur déborde, plein d'admiration",
				"Pour toi, Seigneur, mon Dieu, mon Roi.",
				"Ta perfection, mon inspiration",
				"Et ta bonté me font chanter de joie."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire, honneur,",
				"Puissance et force t'appartiennent,",
				"Oui, t'appartiennent.",
				"Jésus, Sauveur,",
				"Toi, le Messie, mon cœur t'adore.",
				"Mon cœur t'adore."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ton trône, ô Roi, subsistera toujours",
				"Et ta justice demeurera.",
				"Ceint de splendeur, fais triompher le droit,",
				"Défends la vérité, l'humilité."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire, honneur,",
				"Puissance et force t'appartiennent,",
				"Oui, t'appartiennent.",
				"Jésus, Sauveur,",
				"Toi, le Messie, mon cœur t'adore.",
				"Mon cœur t'adore."
			]
		}
	],
