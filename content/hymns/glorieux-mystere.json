	"title": "Glorieux mystère",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1194"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Insondable mystère,",
				"Amour venu sur terre,",
				"Vainqueur de nos frontières,",
				"Tu t’es révélé à nous."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Insaisissable grandeur,",
				"Amour divin créateur,",
				"Par ton Esprit dans nos cœurs,",
				"Viens te révéler à nous."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Revêtu de lumière,",
				"Éclatant de gloire,",
				"Tu restes le même à jamais.",
				"Couronné de splendeur,",
				"À toi soit tout l’honneur,",
				"De tous nos cœurs nous t’adorons."
			]
		},
		{
