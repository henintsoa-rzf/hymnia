	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Considère le mystère, vois, la croix est vide,",
				"Vois le Ressuscité, victorieux et fort.",
				"Aucun ne le surpasse, nul n'est si puissant.",
				"Le Sauveur a vaincu le pouvoir de la mort."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Glorieux, mes yeux ont vu",
				"la gloire du Dieu puissant.",
				"Glorieux, il est plus grand",
				"que tous les rois du monde."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Considère le mystère, vois le Dieu vivant,",
				"Vois le Ressuscité, il règne sur mon cœur.",
				"Aucun ne le surpasse, nul n'est son égal.",
				"L'espoir de son retour remplit tout l'univers."
			]
		},
		{
			"type": "chorus",
			"number": null,
