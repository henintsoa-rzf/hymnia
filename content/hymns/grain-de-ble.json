	"title": "Grain de blé",
	"entries": [
		{
			"hymnal": "arc",
			"number": "652"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Grain de blé qui tombe en terre,",
				"Si tu ne meurs pas,",
				"Tu resteras solitaire,",
				"Ne germera pas."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Qui à Jésus s’abandonne",
				"Trouve la vraie vie.",
				"Heureux l’homme qui se donne ;",
				"Il sera béni."
			]
		}
	],
