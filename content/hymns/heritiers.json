{
	"id": "heritiers",
	"title": "Héritiers",
	"entries": [
		{
			"hymnal": "ecriture",
			"number": "8"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dieu fait éclater son amour",
				"En sacrifiant son Fils.",
				"Déclarés justes pour toujours,",
				"Unis à Jésus-Christ,",
				"Nous sommes enfants du Seigneur ;",
				"Sa grâce nous libère.",
				"Plus d’esclavage, plus de peur,",
				"Nous crions : « Abba, Père ! »"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Justifiés,",
				"Bien-aimés, délivrés,",
				"En Christ jamais condamnés !",
				"Héritiers,",
				"Par le Père, adoptés,",
				"Scellés pour l’éternité !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Le péché veut nous enchaîner,",
				"Mais l’Esprit nous conduit.",
				"Quand nous ne savons que prier,",
				"Il exprime nos cris.",
				"Luttons avec persévérance ;",
				"L’Esprit nous renouvelle !",
				"Souffrons alors dans l’espérance",
				"De la vie éternelle !"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Qui pourrait nous accuser ?",
				"Qui pourrait nous condamner ?",
				"Qui pourrait nous séparer",
				"De l’amour de Dieu en Christ ?"
			]
		}
	],
