	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Homme de douleur, Fils de Dieu",
				"Trahi par les siens,",
				"Le fardeau de notre péché",
				"Sur Jésus fut posé."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C’est lui qu’on a méprisé,",
				"Faussement accusé,",
				"Blessé, meurtri et humilié,",
				"D’épines couronné."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! Cette croix, ma rédemption,",
				"Où ton sang coula pour moi.",
				"Que mon âme s’écrie : « Alléluia,",
				"Gloire et honneur à toi seul. »"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Venu du ciel sur la terre",
				"Pour nous réconcilier,",
				"Pour racheter et pardonner",
				"Ceux qui l’ont crucifié."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! Cette croix, ma rédemption,",
				"Où ton sang coula pour moi.",
				"Que mon âme s’écrie : « Alléluia,",
				"Gloire et honneur à toi seul. »"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Ma dette est payée, elle est effacée",
				"Par le sang précieux que Christ a versé.",
				"Le péché vaincu, son emprise n’est plus.",
				"Il m’a libéré pour l’éternité."
			]
		},
		{
