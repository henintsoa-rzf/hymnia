	"title": "Hosanna au plus haut des cieux",
	"entries": [
		{
			"hymnal": "arc",
			"number": "287"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Hosanna, Hosanna, Hosanna",
				"Au plus haut des cieux ! (bis)",
				"Nous célébrons ton nom",
				"D’un coeur reconnaissant.",
				"Tu es le Seigneur glorieux,",
				"Hosanna au plus haut des cieux !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Louange, louange et gloire",
				"A Jésus, notre Roi ! (bis)",
				"Nous célébrons ton nom",
				"D’un coeur reconnaissant.",
				"Tu es le Seigneur, tu es Roi.",
				"Gloire à toi, Jésus, gloire à toi !"
			]
		}
	],
