	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Dieu immense, créateur parfait.",
				"Dieu immense, amour éternel.",
				"Jésus-Christ, Sauveur de ce monde.",
				"Jésus-Christ, sagesse éternelle.",
				"Esprit saint, vrai consolateur.",
				"Esprit saint, puissance éternelle."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Le ciel et la terre, les hommes et les anges",
				"Louent ton nom.",
				"Le ciel et la terre, les hommes et les anges",
				"Louent ton nom."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Hosanna ! Gloire à celui qui est,",
				"Qui était et qui vient.",
				"Hosanna ! Gloire à celui qui règne",
				"Sur terre ici-bas et dans le ciel."
			]
		}
	],
