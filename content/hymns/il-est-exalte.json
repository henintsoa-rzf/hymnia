{
	"id": "il-est-exalte",
	"title": "Il est exalté",
	"entries": [
		{
			"hymnal": "jem",
			"number": "352"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Il est exalté,",
				"Le Roi est au-dessus des cieux.",
				"Je veux le louer.",
				"Il est élevé, à jamais exalté",
				"Et je loue son saint nom."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Il est Seigneur,",
				"Sa vérité règnera,",
				"Tout l'univers",
				"Se réjouit dans son saint nom.",
				"Il est exalté,",
				"Le Roi est au-dessus des cieux."
			]
		}
	],
