	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il est le même, hier aujourd'hui.",
				"Il est le même, je vis pour lui."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon avenir est entre ses mains,",
				"Je ne craindrai pas le lendemain,",
				"Le monde finira un jour,",
				"Mais Jésus est là pour toujours."
			]
		}
	],
