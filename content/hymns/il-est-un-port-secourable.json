{
	"id": "il-est-un-port-secourable",
	"title": "Il est un port secourable",
	"entries": [
		{
			"hymnal": "atg",
			"number": "317"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Il est un port secourable",
				"Pour les marins en danger,",
				"Contre les vents redoutables",
				"Protégé par un rocher."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Mon rocher, ma forteresse,",
				"Mon asile protecteur,",
				"Mon recours dans la détresse,",
				"C'est Jésus, le Rédempteur !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"À mes pieds l'océan gronde ;",
				"Le vent siffle autour de moi ;",
				"Sur Christ, mon rocher, je fonde",
				"Mon espérance et ma foi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Mon rocher, ma forteresse,",
				"Mon asile protecteur,",
				"Mon recours dans la détresse,",
				"C'est Jésus, le Rédempteur !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"En vain l'ouragan fait rage,",
				"Et nulle clarté ne luit,",
				"Paisible au sein de l'orage,",
				"J'attends l'aube après la nuit."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Mon rocher, ma forteresse,",
				"Mon asile protecteur,",
				"Mon recours dans la détresse,",
				"C'est Jésus, le Rédempteur !"
			]
		}
	],
