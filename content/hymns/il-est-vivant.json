			"hymnal": "jem",
			"number": "320"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Vivant, Jésus est vivant !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"La mort n'a pu le retenir !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Satan n'a pu le détruire !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Vivant, Jésus est vivant !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Nous étions parties",
				"Dans la fraîcheur du matin,",
				"Pour pleurer notre ami",
				"Et sa terrible fin.",
				"Mais le tombeau était vide,",
				"Et la pierre roulée.",
				"Un ange nous dit:",
				"« Jésus est ressuscité ! »"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Vivant, Jésus est vivant !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"La mort n'a pu le retenir !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Satan n'a pu le détruire !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Vivant, Jésus est vivant !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Plongés dans nos pensées,",
				"Nous marchions silencieux.",
				"Tout était fini.",
				"Qui donc nous rendra heureux ?",
				"Un étranger nous dit,",
				"Que rien n'était perdu,",
				"Il rompit le pain",
				"Et nous reconnûmes Jésus !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Vivant, Jésus est vivant !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"La mort n'a pu le retenir !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Satan n'a pu le détruire !",
				"Il est vivant ! Il est vivant ! Il est vivant !",
				"Vivant, Jésus est vivant !",
				"Jésus est vivant ! Jésus est vivant !",
				"Vivant !"
			]
		}
	],
