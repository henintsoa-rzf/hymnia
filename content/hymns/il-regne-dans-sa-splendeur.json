	"title": "Il règne dans sa splendeur",
	"entries": [
		{
			"hymnal": "jem",
			"number": "419"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Il règne dans toute sa splendeur,",
				"Amour victorieux,",
				"Jésus-Christ, le Sauveur",
				"Descendra des cieux.",
				"Toutes dominations",
				"Et royaumes tomberont,",
				"Car son nom est Jésus,",
				"Et il est le Seigneur,"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il est Seigneur, Il est Seigneur,",
				"Il est Seigneur, Il est Seigneur."
			]
		},
