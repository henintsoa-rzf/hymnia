{
	"id": "j-ai-confiance-en-mon-seigneur",
	"title": "J'ai confiance en mon Seigneur",
	"entries": [
		{
			"hymnal": "jem",
			"number": "157"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"J'ai confiance en mon Seigneur,",
				"Le long du chemin,",
				"J'ai confiance en mon Seigneur,",
				"Et il me tient la main.",
				"À travers l'orage grondant,",
				"Mon cœur est en paix,",
				"J'ai confiance en mon Seigneur,",
				"Et je suis gardé !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C'est l'ami fidèle,",
				"Le plus grand ami ;",
				"En toute assurance,",
				"Je m'appuie sur lui.",
				"À travers l'orage grondant,",
				"Mon cœur est en paix,",
				"J'ai confiance en mon Seigneur,",
				"Et je suis gardé !"
			]
		}
	],
