{
	"id": "j-ai-faim-j-ai-soif-jesus",
	"title": "J'ai faim, j'ai soif, Jésus",
	"entries": [
		{
			"hymnal": "atg",
			"number": "193"
		},
		{
			"hymnal": "adf",
			"number": "159"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"J'ai faim, j'ai soif, Jésus ;",
				"sois la manne pour moi !",
				"Eaux vives, jaillissez",
				"du rocher du Calvaire !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"O Pain rompu pour nous,",
				"que je vive de toi !",
				"Je meurs, si tu ne viens",
				"secourir ma misère !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Vendange que foula",
				"le Vigneron divin,",
				"Enivre-moi d'amour,",
				"d'espoir et de courage !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Ta chair, ton sang, Jésus,",
				"sont le pain et le vin",
				"Qui seuls me soutiendront",
				"jusqu'au bout du voyage !"
			]
		}
	],
