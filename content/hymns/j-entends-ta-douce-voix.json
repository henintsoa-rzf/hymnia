	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"J'entends ta douce voix,",
				"Jésus, je viens à toi.",
				"Je viens, ô Sauveur, lave-moi",
				"Dans le sang de ta croix !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Jésus, Roi des rois,",
				"Qui mourus pour moi,",
				"Je veux rester avec toi,",
				"Tiens-moi près de ta croix."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"J'entends ta douce voix,",
				"Qui me dit : « Crois en Moi ! »",
				"Je crois, Seigneur, soutiens ma foi,",
				"Tiens-moi près de ta croix !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Jésus, Roi des rois,",
				"Qui mourus pour moi,",
				"Je veux rester avec toi,",
				"Tiens-moi près de ta croix."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"J'entends ta douce voix,",
				"Elle pénètre en moi",
				"Et me dit d'aimer comme toi",
				"De l'amour de la croix !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Jésus, Roi des rois,",
				"Qui mourus pour moi,",
				"Je veux rester avec toi,",
				"Tiens-moi près de ta croix."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"J'entends ta douce voix,",
				"Toi qui mourus pour moi,",
				"Seigneur, que je m'unisse à toi",
				"Dans ta mort, par la foi !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Jésus, Roi des rois,",
				"Qui mourus pour moi,",
				"Je veux rester avec toi,",
				"Tiens-moi près de ta croix."
			]
		}
	],
