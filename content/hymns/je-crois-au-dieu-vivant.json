{
	"id": "je-crois-au-dieu-vivant",
	"title": "Je crois au Dieu vivant",
	"entries": [
		{
			"hymnal": "atg",
			"number": "88"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Je crois au Dieu vivant,",
				"Des cieux le créateur ;",
				"Je crois qu'il est le Tout-Puissant,",
				"Le seul Seigneur.",
				"Je sais qu'il est amour,",
				"Il m'aime et me conduit ;",
				"Il est ma force et mon secours,",
				"Mon ferme appui."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Je crois au Fils de Dieu,",
				"Jésus le seul Sauveur ;",
				"Je crois qu'il est venu des cieux",
				"Pour nous pécheurs.",
				"Il est mort sur la croix,",
				"Il sort du froid tombeau,",
				"O joie, il vit et règne en moi,",
				"Il vient bientôt."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Je crois au Saint-Esprit,",
				"Le grand Consolateur ;",
				"Je crois que des divins écrits",
				"Il est l'auteur.",
				"Il a scellé ma foi,",
				"Il me guide et m'instruit ;",
				"Par lui, Jésus habite en moi,",
				"Par lui, je vis."
			]
		}
	],
