	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Je m'approche de toi,",
				"Je m'approche de toi,",
				"Source de vie,",
				"Source de vie,",
				"Mon Sauveur, bénis-moi !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Fais silence en mon cœur,",
				"Fais silence en mon cœur,",
				"Viens et me parle,",
				"Viens et me parle,",
				"O mon divin Sauveur !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Rends-moi conforme à toi,",
				"Rends-moi conforme à toi,",
				"Divin Modèle,",
				"Divin Modèle,",
				"Mets ton image en moi !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Rends-moi bouillant, Seigneur !",
				"Rends-moi bouillant, Seigneur !",
				"Pour ton service,",
				"Pour ton service,",
				"Que je parte en vainqueur !"
			]
		}
	],
