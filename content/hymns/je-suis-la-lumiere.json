	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"« Je suis la lumière »,",
				"À dit le Seigneur ;",
				"Avec moi, mon frère,",
				"Ouvre-lui ton cœur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Le monde est plein d'ombre :",
				"Brillons, brillons bien,",
				"Toi dans ton coin sombre,",
				"Et moi dans le mien."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Si la pure flamme",
				"Parfois baisse un peu,",
				"Veillons sur notre âme,",
				"Ravivons le feu."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Le monde est plein d'ombre :",
				"Brillons, brillons bien,",
				"Toi dans ton coin sombre,",
				"Et moi dans le mien."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Quand le jour se voile",
				"Au clair firmament,",
				"La plus humble étoile",
				"Brille doucement."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Le monde est plein d'ombre :",
				"Brillons, brillons bien,",
				"Toi dans ton coin sombre,",
				"Et moi dans le mien."
			]
		}
	],
