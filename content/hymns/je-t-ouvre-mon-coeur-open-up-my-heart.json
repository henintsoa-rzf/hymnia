{
	"id": "je-t-ouvre-mon-coeur-open-up-my-heart",
	"title": "Je t’ouvre mon cœur (Open Up My Heart)",
	"entries": [
		{
			"hymnal": "psalmodie",
			"number": "310"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Je t’ouvre mon coeur, Seigneur, fais-le brûler par ton Esprit;",
				"Pénètre jusqu’au fond de moi, au fond de mon être.",
				"Reçois ma vie, mon désir est de te servir.",
				"A ton appel je réponds : «Oui», je ne recule pas."
			]
		}
	],
