	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Qu’importent mes peurs,",
				"Je me confie en toi, en toi.",
				"Divin créateur,",
				"Rien n’est trop grand pour toi, pour toi,"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Car tu es puissant,",
				"Je ne manquerai de rien.",
				"Tu es ma force et ma vie t’appartient."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Je veux proclamer",
				"Que Jésus-Christ est Roi, il est Roi.",
				"Il est vivant et son Esprit est en moi, en moi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Mes yeux sont sur toi,",
				"Tu garderas mes pas, mes pas.",
				"Rien ne te surprend,",
				"Tu veilles sur mes voies, mes voies,"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Car tu es puissant,",
				"Je ne manquerai de rien.",
