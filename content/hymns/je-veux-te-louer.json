			"lines": [
				"Je veux te louer,",
				"Toi qui m'as aimé.",
				"Comment m'exprimer",
				"Pour te remercier ?",
				"Tu as rempli ma vie",
				"De joie et d'harmonie:",
				"Oh ! Merci !"
			]
		}
	],
