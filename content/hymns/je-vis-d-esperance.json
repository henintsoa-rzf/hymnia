{
	"id": "je-vis-d-esperance",
	"title": "Je vis d'espérance.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "400"
		},
		{
			"hymnal": "cd",
			"number": "356"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Je vis d'espérance,",
				"D'amour et de foi,",
				"Et mon chant s'élance",
				"Vers toi, divin Roi.",
				"Grande est ma faiblesse,",
				"Mon indignité ;",
				"Mais dans ta tendresse",
				"Tu m'as racheté."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oui, mon cœur chante,",
				"Mon âme est contente.",
				"Mon Jésus est tout mon bien,",
				"Je ne craindrai rien !",
				"Oui, mon cœur chante,",
				"Mon âme est contente.",
				"Mon Jésus est tout mon bien,",
				"Je ne craindrai rien !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Oh ! quelle tendresse,",
				"Quel immense amour !",
				"Cet amour me presse",
				"D'aimer à mon tour :",
				"Aimer, c'est te suivre",
				"Et c'est t'obéir.",
				"Aimer, oui, c'est vivre",
				"Et s'épanouir."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oui, mon cœur chante,",
				"Mon âme est contente.",
				"Mon Jésus est tout mon bien,",
				"Je ne craindrai rien !",
				"Oui, mon cœur chante,",
				"Mon âme est contente.",
				"Mon Jésus est tout mon bien,",
				"Je ne craindrai rien !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Que, le cœur en fête,",
				"La nuit et le jour,",
				"Toujours je reflète",
				"Ton immense amour !",
				"L'amour qui rayonne,",
				"Te gagnant les cœurs,",
				"Voilà la couronne",
				"Au front des vainqueurs !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oui, mon cœur chante,",
				"Mon âme est contente.",
				"Mon Jésus est tout mon bien,",
				"Je ne craindrai rien !",
				"Oui, mon cœur chante,",
				"Mon âme est contente.",
				"Mon Jésus est tout mon bien,",
				"Je ne craindrai rien !"
			]
		}
	],
