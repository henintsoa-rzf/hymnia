{
	"id": "jesus-christ-notre-esperance",
	"title": "Jésus-Christ, notre espérance",
	"entries": [
		{
			"hymnal": "arc",
			"number": "465"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Jésus-Christ, notre espérance,",
				"Aux pécheurs est livré.",
				"Dans la souffrance,",
				"Il porte nos offenses.",
				"Seigneur, Seigneur, aie pitié."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Sa mort fut notre baptême,",
				"Notre mort au péché.",
				"Vivons fidèles,",
				"La vie enfin nouvelle.",
				"Seigneur, Seigneur, aie pitié."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Jésus-Christ, le Seigneur, règne ;",
				"Il a tout dans sa main,",
				"Grâce et détresse,",
				"La vie et la mort même.",
				"Seigneur, Seigneur, aie pitié."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Jésus-Christ est notre fête ;",
				"Nous voici délivrés,",
				"Car la lumière",
				"Sur le peuple se lève.",
				"Seigneur, Seigneur, aie pitié."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Gloire soit à Dieu le Père,",
				"À l’Esprit de clarté.",
				"Gloire éternelle",
				"À toi qui nous éveilles,",
				"Le Christ est ressuscité."
			]
		}
	],
