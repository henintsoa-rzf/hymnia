{
	"id": "jesus-demeure",
	"title": "Jésus demeure",
	"entries": [
		{
			"hymnal": "jem",
			"number": "94"
		},
		{
			"hymnal": "cd",
			"number": "98"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Quand sur la terre tout déçoit,",
				"Que tout semble vain,",
				"Un ami dans ton effroi,",
				"Près de toi se tient."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Seul Jésus demeure, seul Jésus demeure.",
				"Terre et ciel pourraient passer:",
				"Toujours Jésus demeure."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quand le ciel est noir et lourd,",
				"Que l'orage vient,",
				"Christ est là, son grand amour",
				"Près de toi se tient."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Seul Jésus demeure, seul Jésus demeure.",
				"Terre et ciel pourraient passer:",
				"Toujours Jésus demeure."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"À l'heure où la sombre mort",
				"Croise ton chemin,",
				"C'est Jésus qui veille encore",
				"Et vers toi se tient."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Seul Jésus demeure, seul Jésus demeure.",
				"Terre et ciel pourraient passer:",
				"Toujours Jésus demeure."
			]
		}
	],
