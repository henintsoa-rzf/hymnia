{
	"id": "jesus-en-croix",
	"title": "Jésus en croix",
	"entries": [
		{
			"hymnal": "arc",
			"number": "461"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"Tu dis en redressant ton front",
				"Sous la douleur amère :",
				"“Comme ils ne savent ce qu’ils font,",
				"Pardonne-leur, ô Père”."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"A l’un des deux brigands, tu dis,",
				"Qui attendait ton règne :",
				"“Aujourd’hui dans mon paradis,",
				"Ta place est toute prête”."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"En la voyant dans la douleur,",
				"Tu as dit à ta mère :",
				"“Voici ton fils”, et puis tu dis :",
				"“Ami, voici ta mère”."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"Tu as crié dans ton tourment",
				"Où Dieu n’est qu’une absence :",
				"“Pourquoi m’as tu abandonné,",
				"Mon Dieu, dans le silence ?”."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"Tu as crié quand tu voulus",
				"Souffrir de nos misères :",
				"“J’ai soif, j’ai soif” et tu reçus",
				"L’éponge et le vinaigre."
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"Les lèvres sèches, tu as dit :",
				"“Je suis là pour cette heure,",
				"Maintenant, tout est accompli”",
				"Et seul l’amour demeure."
			]
		},
		{
			"type": "verse",
			"number": 7,
			"lines": [
				"Jésus en croix, Jésus mourant,",
				"Tu as crié, Dieu si humain :",
				"“Je remets, ô mon Père,",
				"Je mets mon esprit en tes mains”,",
				"O grâce du Calvaire."
			]
		}
	],
