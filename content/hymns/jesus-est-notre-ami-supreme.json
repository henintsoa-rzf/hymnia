{
	"id": "jesus-est-notre-ami-supreme",
	"title": "Jésus est notre ami suprême",
	"entries": [
		{
			"hymnal": "atg",
			"number": "165"
		},
		{
			"hymnal": "adf",
			"number": "69"
		},
		{
			"hymnal": "arc",
			"number": "413"
