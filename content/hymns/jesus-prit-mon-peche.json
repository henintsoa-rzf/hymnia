	"title": "Jésus prit mon péché",
	"entries": [
		{
			"hymnal": "cd",
			"number": "173"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Jésus prit mon péché car il m’aime,",
				"Je compris alors son amour,",
				"Je reçus mon Sauveur en moi-même",
				"Et je fus délivré dès ce jour.",
				"Chante gloire, chante gloire,",
				"Chante à la gloire du Roi des rois.",
				"Chante gloire, chante gloire,",
				"Chante à Jésus notre roi."
			]
		}
	],
