		{
			"type": "verse",
			"number": 1,
			"lines": [
				"L'Évangile est annoncé,",
				"La semence est plantée",
				"Et bientôt apparaîtra une moisson dorée."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! Jésus régnera. Jésus régnera !",
				"Oh ! Jésus régnera. Oui, Jésus régnera !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Rendre espoir aux opprimés,",
				"C'est le désir du Père.",
				"Partageons son grand amour,",
				"Soyons sel et lumière."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! Jésus régnera. Jésus régnera !",
				"Oh ! Jésus régnera. Oui, Jésus régnera !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Sa puissance est libérée",
				"À travers nos prières ;",
				"Les démons sont repoussés,",
				"Soudain la nuit s'éclaire."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oh ! Jésus régnera. Jésus régnera !",
				"Oh ! Jésus régnera. Oui, Jésus régnera !",
				"Oh ! Jésus régnera. Jésus régnera !",
				"Oh ! Jésus régnera. Oui, Jésus régnera !",
				"Jésus régnera, Jésus régnera !"
