			"lines": [
				"Jésus, ressuscité !",
				"Assis à la droite du Père,",
				"Tu es au-dessus de tout pouvoir,",
				"De toute autorité."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
