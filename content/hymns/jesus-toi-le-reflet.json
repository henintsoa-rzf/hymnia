{
	"id": "jesus-toi-le-reflet",
	"title": "Jésus, toi le reflet",
	"entries": [
		{
			"hymnal": "jem",
			"number": "435"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Jésus, toi le reflet",
				"de la splendeur du Père.",
				"Tu es le Fils, l'héritier choisi.",
				"Par toi, tout fut créé.",
				"Par ta parole puissante",
				"tu soutiens tout l'univers.",
				"Du péché tu nous as lavés,",
				"Tu es élevé, Seigneur,",
				"à la droite de Dieu."
			]
		},
		{
