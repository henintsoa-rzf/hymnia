	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Jour de joie, jour de victoire,",
				"Il étend sa main d'en haut,",
				"Me retire des grandes eaux ;",
				"Il me saisit et me délivre.",
				"L'Éternel est mon appui",
				"Devant tous mes ennemis.",
				"Dieu se lève avec éclat",
				"Et il marche devant moi."
			]
		}
	],
