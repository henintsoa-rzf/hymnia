{
	"id": "jour-du-seigneur-arc-226",
	"title": "Jour du Seigneur",
	"entries": [
		{
			"hymnal": "arc",
			"number": "226"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Jour du Seigneur",
				"Où de mon coeur",
				"S’élance une prière ;",
				"Jour merveilleux",
				"Où tout joyeux",
				"Je reçois ta lumière."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu es amour",
				"Et chaque jour",
				"Je vis par ta promesse.",
				"Eclaire-moi,",
				"Soutiens ma foi ;",
				"Tu connais ma faiblesse."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"A tes côtés,",
				"par ta bonté,",
				"Je marche en confiance.",
				"Tous mes péchés",
				"Sont pardonnés ;",
				"J’en ai pleine assurance."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Et ton amour",
				"Sera toujours",
				"Une ardente lumière.",
				"De tout mon coeur,",
				"Avec ferveur,",
				"Je me donne à toi, Père."
			]
		}
	],
