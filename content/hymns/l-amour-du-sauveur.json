	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"L'amour du Sauveur,",
				"Tel un vaste océan,",
				"Inonde mon cœur,",
				"De son flot puissant.",
				"Il est doux et tendre,",
				"Immense, infini,",
				"Et pour toujours me suffit."
			]
		}
	],
