	"sections": [
		{
			"type": "other",
			"number": null,
			"lines": [
				"Quand les épreuves",
				"Me font douter de toi,",
				"Ta voix soutient mes pas.",
				"Et dans ma peine",
				"Je sens toujours tes bras",
				"Qui me ramènent à toi."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Quand je suis faible",
				"Et que mon pied chancelle,",
				"Tu es toujours fidèle",
				"Car à chaque heure",
				"Ton Esprit me rappelle",
				"Ton alliance éternelle !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Ta promesse en moi",
				"Est l'ancre de ma foi,",
				"Ton amour pour moi",
				"Ne faillit pas."
			]
		},
		{
			"type": "chorus",
