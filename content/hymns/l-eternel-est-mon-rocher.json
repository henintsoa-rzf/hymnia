	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"L'Éternel est mon rocher,",
				"Ma forteresse et mon libérateur.",
				"Dieu est mon rocher,",
				"Où je trouve un abri,",
				"Mon bouclier et la force qui me sauve,",
				"Ma haute retraite et mon refuge."
			]
		},
