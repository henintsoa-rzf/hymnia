{
	"id": "l-univers-chante-le-nom",
	"title": "L'univers chante le nom",
	"entries": [
		{
			"hymnal": "jem",
			"number": "919"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"L'univers chante le nom",
				"Du Dieu de la création,",
				"Et ma voix se joint au chœur",
				"De ceux qui louent ta grandeur."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Devant ta sainte présence,",
				"Je veux fléchir le genou.",
				"Transformé par ta puissance,",
				"Je proclamerai partout :"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Jésus, tu es tout pour moi,",
				"Ma joie, mon espoir !",
				"Jésus, je suis tout à toi,",
				"Ma vie et ma gloire ! »"
			]
		}
	],
