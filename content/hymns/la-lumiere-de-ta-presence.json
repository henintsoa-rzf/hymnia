			"lines": [
				"La lumière de ta présence",
				"réchauffe mon âme.",
				"La beauté de ton regard",
				"fait vibrer mon cœur."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Brille dans ma nuit, toi, lumière du monde.",
