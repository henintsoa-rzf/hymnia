	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Reçois la paix du Seigneur",
				"Dans ton cœur maintenant !",
				"Reçois la paix du Seigneur",
				"Dans ton cœur maintenant",
				"Et pour toujours !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu te bénisse et qu'il te garde,",
				"Que son visage brille toujours sur toi !",
				"Dieu te bénisse et qu'il te garde,",
				"Que son visage brille toujours sur toi !",
				"Reçois sa paix ! Reçois sa paix !"
			]
		}
	],
