{
	"id": "la-seule-source-d-eau-vive",
	"title": "La seule source d'eau vive",
	"entries": [
		{
			"hymnal": "jem",
			"number": "630"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Je veux, avec foi,",
				"Progresser dans tes voies.",
				"Entendre comme toi,",
				"Tout voir comme tu vois."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es la seule source d'eau vive",
				"Qui peut apaiser toute soif.",
				"En nous tu viens faire battre ton cœur.",
				"Auprès de toi, personne n'est seul."
			]
		}
	],
