	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Le Christ est ressuscité, Alléluia !",
				"Comme il l’avait annoncé, Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Il nous a donné sa joie, Alléluia !",
				"La souffrance de la croix, Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Pour chaque homme chaque jour, Alléluia !",
				"Il donne son pain d’amour, Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Près de son Père il attend, Alléluia !",
				"Ceux qui gardent un coeur d’enfant, Alléluia !"
			]
		}
	],
