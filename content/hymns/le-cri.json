	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Gloire, honneur, force et puissance",
				"te reviennent,",
				"Notre Dieu, puissant guerrier.",
				"Éternel, nul n'est comparable à toi,",
				"Nul n'est comparable à toi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ton amour nous affranchit, nous relève,",
				"Victorieux dans chaque combat, nous appelle.",
				"Nul n'est comparable à toi,",
				"Nul n'est comparable à toi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Entends le cri de nos cœurs.",
				"Tu es Roi, seul vainqueur.",
				"Libérés, nous proclamons ta grâce,",
				"ta majesté."
			]
		},
