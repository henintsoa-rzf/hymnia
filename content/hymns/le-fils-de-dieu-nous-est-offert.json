{
	"id": "le-fils-de-dieu-nous-est-offert",
	"title": "Le Fils de Dieu nous est offert",
	"entries": [
		{
			"hymnal": "arc",
			"number": "596"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Le Fils de Dieu nous est offert,",
				"Nous acclamons le Rédempteur.",
				"Il a pour nous tout accompli.",
				"Célébrons tous le Seigneur,",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Agneau pascal libérateur,",
				"Tu viens offrir le pain de vie.",
				"Tu es le grain ressuscité.",
				"Célébrons tous le Seigneur,",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Homme parfait, vrai serviteur,",
				"Tu nous aimas d’un grand amour.",
				"En tout humain, aimons le Christ.",
				"Célébrons tous le Seigneur,",
				"Alléluia !",
				"Vivre en Christ"
			]
		}
	],
