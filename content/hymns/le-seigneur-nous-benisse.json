			"hymnal": "adf",
			"number": "573"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Le Seigneur nous bénisse et nous garde ;",
				"Le Seigneur nous bénisse et nous garde ;",
				"Le Seigneur fasse luire sa lumière sur nous",
				"Et nous soit propice !",
				"Le Seigneur tourne sa face vers nous",
				"Et nous donne paix et salut !",
				"Amen ! Amen !",
				"Amen ! Au Nom de Jésus,",
				"Au Nom de Jésus, Amen !"
			]
		}
	],
