			"type": "verse",
			"number": 1,
			"lines": [
				"Lève tes yeux et contemple",
				"Jésus s'immolant sur la croix !",
				"C'est pour toi, pécheur,",
				"qu'il souffre et qu'il meurt,",
				"Attaché sur cet infâme bois !"
			]
		}
	],
