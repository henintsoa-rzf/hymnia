{
	"id": "lion-de-juda",
	"title": "Lion de Juda",
	"entries": [
		{
			"hymnal": "jem",
			"number": "280"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Lion de Juda sur le trône,",
				"Tu viens établir ton royaume.",
				"Toi, le Roi des rois,",
				"Le Prince de paix,",
				"Et ton règne dure à jamais."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire au grand Roi,",
				"Gloire au grand Roi !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Lion de Juda, tu naquis",
				"Parmi les pauvres, les petits,",
				"Livré sur la croix",
				"Aux mains des méchants,",
				"Mais ressuscité triomphant !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Alléluia,",
				"Alléluia."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Lion de Juda, viens bientôt",
				"Etablir un monde nouveau.",
				"Qui revive enfin",
				"Et chante de joie",
				"L'univers que tu rachetas."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Maranatha,",
				"Maranatha."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Lion de Juda sur le trône,",
				"Tu viens établir ton royaume.",
				"Toi, le Roi des rois,",
				"Le Prince de paix,",
				"Et ton règne dure à jamais."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire au grand Roi,",
				"Gloire au grand Roi !",
				"Tu es mon Roi !",
				"Alléluia ! Tu es mon Roi !"
			]
		}
	],
