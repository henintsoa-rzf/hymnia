	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Louange et gloire à ton nom,",
				"alléluia, alléluia !",
				"Seigneur, Dieu de l'univers,",
				"alléluia, alléluia !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux.",
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Venez, chantons notre Dieu,",
				"alléluia, alléluia !",
				"C'est lui notre créateur,",
				"alléluia, alléluia !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux.",
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Pour nous, il fit des merveilles,",
				"alléluia, alléluia !",
				"Éternel est son amour,",
				"alléluia, alléluia !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux.",
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Je veux chanter pour mon Dieu,",
				"alléluia, alléluia !",
				"Tous les jours de ma vie,",
				"alléluia, alléluia !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire à Dieu, gloire à Dieu,",
				"Au plus haut des cieux.",
