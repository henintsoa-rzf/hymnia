{
	"id": "louez-adonai",
	"title": "Louez Adonaï",
	"entries": [
		{
			"hymnal": "jem",
			"number": "786"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Qui est semblable au Lion, à l'Agneau",
				"Assis sur le trône ?",
				"Les monts s'inclinent, l'océan rugit",
				"Devant le Seigneur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Louez Adonaï, du lever du soleil",
				"et jusqu'à la fin du jour,",
				"louez Adonaï !",
				"Toutes les nations du monde,",
				"Tous les anges et tous les saints te louent."
			]
		},
