{
	"id": "ma-passion",
	"title": "Ma passion",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1136"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Quand les montagnes trembleront,",
				"Quand je serai éprouvé,",
				"Et ma vie en plein désert,",
				"En attendant ta lumière,",
				"Dans mon histoire,",
				"Au cœur de mes larmes,",
				"De mes nuits, je redirai :"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Tu seras mon cri,",
				"Tu seras ma voix,",
				"Tu seras le battement de mon cœur.",
				"Tu seras ma vie,",
				"Tu seras ma joie,",
				"Tu seras ma passion, oh ! Seigneur. »"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Tu seras mon cri,",
				"Tu seras ma voix,",
				"Tu seras le battement de mon cœur.",
				"Tu seras ma vie,",
				"Tu seras ma joie,",
				"Tu seras ma passion, oh ! Seigneur. »"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quand je ne sais où aller,",
				"Mon cœur seul, abandonné,",
				"Quand je dois quitter ma terre",
				"Pour découvrir ta lumière,",
				"Dans mon histoire,",
				"Au cœur de mes larmes,",
				"De mes nuits, je redirai :"
			]
		},
