{
	"id": "majestueux",
	"title": "Majestueux",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1055"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Assis dans le ciel, ton trône éternel,",
				"Tu règnes à jamais, vêtu de splendeur,",
				"Entouré d'honneur et de majesté.",
				"Les anges chantent : « À toi la gloire ! »"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Les cieux et les mers, la vie, la lumière",
				"Nous parlent de toi. Tu les as créés,",
				"Les as appelés au son de ta voix.",
				"La terre chante :"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Majestueux, souverain,",
				"Dieu tout-puissant, tu es saint ! »",
				"La création loue ton nom,",
				"Tout l'univers déclare : « À toi la gloire ! »"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Ô Roi serviteur, tu vins sur la terre",
				"Révéler l'amour.",
				"Divin créateur, merveilleux Sauveur,",
				"Tu vis pour toujours.",
				"Tes enfants chantent :"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Majestueux, souverain,",
				"Dieu tout-puissant, tu es saint ! »",
				"La création loue ton nom,",
				"Tout l'univers déclare :"
			]
		},
		{
			"type": "other",
			"number": null,
			"lines": [
				"« Majestueux, souverain,",
				"Dieu tout-puissant, tu es saint ! »",
				"La création loue ton nom,",
				"Tout l'univers déclare,",
				"Tout l'univers déclare : « À toi la gloire ! »",
				"Oh ! oh !"
			]
		}
	],
