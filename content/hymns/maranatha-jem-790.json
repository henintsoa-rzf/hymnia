				"Il revient victorieux, il revient majestueux.",
				"Maranatha, Jésus revient !",
				"Il revient victorieux, il revient majestueux.",
				"Maranatha, Jésus revient !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Un cri de triomphe, l'éclair, le tonnerre",
				"Et les voix des anges",
				"sortent au-devant du trône de Dieu."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il revient victorieux, il revient majestueux.",
				"Maranatha, Jésus revient !",
				"Il revient victorieux, il revient majestueux.",
				"Maranatha, Jésus revient !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quand il reviendra, tout œil le verra,",
				"Chacun fléchira,",
				"rien ni personne ne tiendra devant lui."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Il revient victorieux, il revient majestueux.",
				"Maranatha, Jésus revient !",
				"Jésus, Jésus revient !",
				"Jésus, Jésus revient !"
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Quand ce jour apparaîtra,",
				"Tous confesseront son nom,",
				"Tous proclameront ensemble",
				"Le nom qui sauve, le nom qui délivre.",
				"Quand ce jour apparaîtra,",
				"Nous le couronnerons roi.",
				"Il est digne de recevoir",
				"Honneur et gloire, puissance et majesté."
			]
		},
		{
			"type": "chorus",
