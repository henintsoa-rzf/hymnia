{
	"id": "marchons-avec-joie",
	"title": "Marchons avec joie",
	"entries": [
		{
			"hymnal": "atg",
			"number": "337"
		},
		{
			"hymnal": "adf",
			"number": "464"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Marchons avec joie",
				"Dans le bon chemin,",
				"Dans l'étroite voie",
				"Du bonheur sans fin.",
				"Laissons en arrière",
				"Les biens d'ici-bas ;",
				"Prions notre Père",
				"De guider nos pas.",
				"Comptant sur sa grâce,",
				"Remplis de sa paix,",
				"Que rien n'embarrasse",
				"Nos pas désormais."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Si rude est la route,",
				"Glissant le sentier,",
				"Le Seigneur écoute",
				"Qui le sait prier.",
				"Il est la lumière,",
				"Le libérateur",
				"Du cœur qui n'espère",
				"Qu'en son Dieu-Sauveur.",
				"Sa toute-puissance",
				"Défend le croyant ;",
				"Son amour immense",
				"sauve son enfant."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Et quand sonne l'heure",
				"De quitter ces lieux,",
				"Il a pour demeure",
				"Le palais des cieux !",
				"Vêtements de gloire,",
				"D'immortalité,",
				"Palmes de victoire",
				"Pour l'éternité !",
				"Voilà ce que donne",
				"Le Seigneur Jésus !",
				"Voilà la couronne",
				"De tous les élus."
			]
		}
	],
