			"type": "verse",
			"number": 1,
			"lines": [
				"Matelots, en voyage",
				"Vers le bord éternel,",
				"S'il survient un orage,",
				"Pensons au doux rivage,",
				"Pensons au doux rivage ;"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Notre port, notre port est au ciel ;",
				"Notre port, notre port est au ciel ;",
				"Notre port est au ciel,",
				"Notre port est au ciel,",
				"Notre port est au ciel !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Que rien ne nous dérive",
				"Vers les biens temporels,",
				"Leur paix est fugitive ;",
				"Ne cherchons qu'une rive ;",
				"Ne cherchons qu'une rive ;"
			]
		},
		{
