	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Merveilleux amour,",
				"Amour de Dieu pour moi !",
				"Merveilleux amour,",
				"De Jésus sur la croix !",
				"Vaste autant que les océans,",
				"Profond plus que les mers,",
				"Haut, plus haut que l'azur des cieux",
				"Est son amour."
			]
		}
	],
