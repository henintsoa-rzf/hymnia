			"lines": [
				"Moi, j'ai confiance en ta bonté,",
				"Moi, j'ai confiance en ta bonté.",
				"J'ai de l'allégresse dans le cœur",
				"À cause de ton salut ;",
				"Je chante à l'Éternel,",
				"Car il m'a fait du bien."
			]
		}
