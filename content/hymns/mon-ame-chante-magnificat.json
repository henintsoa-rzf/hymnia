{
	"id": "mon-ame-chante-magnificat",
	"title": "Mon âme chante (Magnificat)",
	"entries": [
		{
			"hymnal": "arc",
			"number": "173"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon âme chante le Seigneur",
				"Et dans mon coeur il n’est que joie.",
				"Alléluia ! Alléluia !",
				"Il a jeté les yeux sur moi ;",
				"En moi son nom sera béni.",
				"Alléluia ! Alléluia ! Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"De ses merveilles il m’a comblée ;",
				"Saint est son nom dans tous les temps.",
				"Alléluia ! Alléluia !",
				"Il fait tomber les orgueilleux,",
				"Mais il relève les petits.",
				"Alléluia ! Alléluia ! Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Il rassasie les affamés",
				"Mais il renvoie les suffisants.",
				"Alléluia ! Alléluia !",
				"Il vient en aide à Israël ;",
				"Il se souvient de son amour.",
				"Alléluia ! Alléluia ! Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Envers son peuple bien-aimé,",
				"Il tient promesse pour toujours.",
				"Alléluia ! Alléluia !",
				"Gloire et louange à notre Dieu,",
				"Gloire à Jésus, au Saint-Esprit.",
				"Alléluia ! Alléluia ! Alléluia !"
			]
		}
	],
