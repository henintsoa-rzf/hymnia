{
	"id": "mon-ame-en-silence",
	"title": "Mon âme en silence.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "578"
		},
		{
			"hymnal": "cd",
			"number": "261"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon âme en silence",
				"Se tient devant toi,",
				"Oh ! rends ta présence",
				"Sensible à ma foi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Je ne veux connaître",
				"Aucune autre voix",
				"Que la tienne, ô Maître,",
				"Toi seul, parle-moi !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Parole bénie",
				"De mon Rédempteur,",
				"Parole de vie,",
				"Pénètre en mon cœur."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Oui, daigne m'instruire",
				"Et dis tout, Seigneur,",
				"Ce que tu dois dire",
				"À ton serviteur."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Seigneur, je t'écoute,",
				"Seigneur, parle-moi !",
				"Sans crainte, ni doute,",
				"Je m'attends à toi."
			]
		}
	],
