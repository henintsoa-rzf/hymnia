{
	"id": "mon-dieu-mon-pere",
	"title": "Mon Dieu, mon Père",
	"entries": [
		{
			"hymnal": "atg",
			"number": "209"
		},
		{
			"hymnal": "adf",
			"number": "181"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon Dieu, mon Père,",
				"Écoute-moi,",
				"Car ma prière",
				"S'élève à toi.",
				"En Jésus-Christ,",
				"Tu nous l'as dit,",
				"Je puis, Seigneur,",
				"T'ouvrir mon cœur.",
				"Ah ! fais-moi grâce,",
				"Dieu tout-puissant !",
				"Tourne ta face",
				"Vers ton enfant."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Viens, je te prie,",
				"Change mon cœur ;",
				"Guide ma vie",
				"Loin de l'erreur.",
				"Mon seul désir",
				"Est de choisir",
				"La bonne part",
				"Sous ton regard.",
				"Que mon offense",
				"Ne lasse plus",
				"Ta patience,",
				"Seigneur Jésus !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Fais-moi comprendre",
				"Ta charité",
				"Et bien entendre",
				"Ta vérité.",
				"Oui, que ta main,",
				"Sur mon chemin,",
				"Soit, ô Dieu fort,",
				"Mon seul support !",
				"Que ta puissance",
				"Soit chaque jour",
				"Ma délivrance,",
				"O Dieu d'amour !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Rends-moi fidèle",
				"Par ton secours,",
				"Et sous ton aile",
				"Tiens-moi toujours ;",
				"Loin du danger,",
				"O bon Berger !",
				"Conduis mes pas",
				"Jusqu'au trépas.",
				"Vois ma faiblesse",
				"Et me soutiens",
				"Par ta tendresse :",
				"Je t'appartiens."
			]
		}
	],
