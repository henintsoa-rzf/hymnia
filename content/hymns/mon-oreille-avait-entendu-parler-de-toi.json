	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon oreille avait entendu parler de toi,",
				"Mais maintenant mon œil te voit,",
				"Maintenant mon œil te voit,",
				"Maintenant mon œil te voit,",
				"Jésus, mon Roi !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Désormais, je veux célébrer",
				"Ton nom Seigneur,",
				"Car maintenant mon œil te voit,",
				"Maintenant mon œil te voit,",
				"Maintenant mon œil te voit,",
				"Jésus, mon Roi !"
			]
		}
	],
