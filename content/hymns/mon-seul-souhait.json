{
	"id": "mon-seul-souhait",
	"title": "Mon seul souhait",
	"entries": [
		{
			"hymnal": "jem",
			"number": "877"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Mon seul souhait dans ce monde",
				"Est de te rencontrer.",
				"Chaque jour, que je vis,",
				"Je ne cesse de croire en ton nom,",
				"En ton nom."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es mon maître et je veux me soumettre",
				"À ta volonté mon bien-aimé.",
				"C'est en toi que j'espère. Tu me relèves",
				"Dieu de bonté, Dieu de majesté.",
				"Je t'adore, je t'adore."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Éternel, Dieu fidèle,",
				"Je cherche à te suivre.",
				"Chaque jour, que je vis,",
				"Je ne cesse de croire en ton nom,",
				"En ton nom."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es mon maître et je veux me soumettre",
				"À ta volonté mon bien-aimé.",
				"C'est en toi que j'espère. Tu me relèves",
				"Dieu de bonté, Dieu de majesté.",
				"Je t'adore, je t'adore."
			]
		}
	],
