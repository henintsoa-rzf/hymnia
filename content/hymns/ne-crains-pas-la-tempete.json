	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ne crains pas la tempête,",
				"Reste tranquille la paix viendra,",
				"Relève donc la tête,",
				"Regarde à Jésus, sois plein de foi.",
				"Qu'importe l'adversaire,",
				"Chasse la crainte",
				"Il est vaincu ;"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Au nom puissant de Jésus",
				"L'ennemi s'enfuit,",
				"Tu es vainqueur !",
				"Au nom puissant de Jésus",
				"L'ennemi s'enfuit,",
				"Tu es vainqueur !"
			]
		}
	],
