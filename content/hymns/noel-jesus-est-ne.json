	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Noël ! Jésus est né.",
				"La lumière a resplendi.",
				"Noël ! Jésus est né,",
				"Dans les cieux l'étoile luit.",
				"Mages d'Orient,",
				"Adorez l'enfant",
				"Car il vient du ciel.",
				"Il est l'Éternel.",
				"Chantons Noël."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Il est Emmanuel !",
				"Dieu est venu parmi nous.",
				"Chantons Noël, Noël,",
				"Car il vient nous sauver tous.",
				"Car Emmanuel,",
				"Est venu du ciel",
				"Pour nous racheter",
				"Et nous délivrer",
				"De nos péchés."
			]
		}
	],
