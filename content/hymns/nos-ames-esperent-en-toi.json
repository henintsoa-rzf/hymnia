	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Nous chérissons ta présence,",
				"Désirons ton abondance.",
				"Tu es la source de tout."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Nos âmes espèrent en toi.",
				"Tu es notre Dieu, sois loué en ce lieu.",
				"Nos âmes espèrent en toi.",
				"Tu es notre Dieu, sois loué en ce lieu."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Nous voulons être près de toi,",
				"À chaque instant, à chaque pas.",
				"Tu es la source de tout."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Nos âmes espèrent en toi.",
				"Tu es notre Dieu, sois loué en ce lieu.",
				"Nos âmes espèrent en toi.",
