{
	"id": "notre-pere-exo-18",
	"title": "Notre Père",
	"entries": [
		{
			"hymnal": "exo",
			"number": "18"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Notre Père",
				"Qui es aux cieux",
				"Que ton nom",
				"Soit sanctifié",
				"Que ton règne",
				"Vienne",
				"Que ta volonté soit faite",
				"Sur la terre comme au ciel",
				"(Comme au ciel)",
				"Donne-nous",
				"Notre pain",
				"Aujourd'hui",
				"Et demain"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Pardonne-nous",
				"Nos offenses",
				"Comme nous les pardonnons",
				"À tous ceux",
				"Qui nous ont offensés"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Ne nous soumets pas",
				"À la tentation",
				"Mais délivre-nous du mal (x2)"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Car c'est à toi qu'appartiennent",
				"Pour les siècles des siècles",
				"Le règne, ta puissance",
				"Et la gloire"
			]
		}
	],
