	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Notre Père dans le ciel,",
				"Que ton nom soit sanctifié,",
				"Que ton royaume vienne.",
				"Nous voulons faire ta volonté."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Donne-nous aujourd’hui",
				"Le pain dont nous avons besoin.",
				"Le pardon est acquis",
				"Pour nous et pour notre prochain."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Gloire à Dieu, gloire à notre Père.",
				"Gloire à Dieu, gloire à Dieu,",
				"Gloire à notre Père,",
				"À lui le règne, la puissance,",
				"Amen."
			]
		},
		{
			"type": "bridge",
			"number": null,
			"lines": [
				"Nous ne chancellerons",
				"Face à nos tentations.",
				"Tu nous délivres du mal.",
				"À toi nos louanges,",
				"À toi nos honneurs et nos cœurs."
			]
		},
		{
