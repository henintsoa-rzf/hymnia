	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Sois couronné, élevé par nos louanges.",
				"Sois couronné, Dieu puissant.",
				"Nous élevons nos voix proclamant ta gloire.",
				"Sois couronné, Dieu puissant.",
				"Sois couronné, élevé par nos louanges.",
				"Sois couronné, Dieu puissant.",
				"Nous élevons nos voix proclamant ta gloire.",
				"Sois couronné, Dieu puissant."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Un parfum agréable",
				"devant ton trône, Seigneur,",
				"La gloire et l'honneur",
				"toujours nous offrirons,",
				"À l'Agneau qui siège sur un trône éternel."
			]
		},
		{
			"type": "verse",
			"number": 2,
