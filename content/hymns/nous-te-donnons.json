{
	"id": "nous-te-donnons",
	"title": "Nous te donnons",
	"entries": [
		{
			"hymnal": "jem",
			"number": "873"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"O Seigneur enseigne-nous",
				"À te louer, t'adorer,",
				"En esprit et en vérité,",
				"Pour que d'un même cœur,",
				"Avec un même chant,",
				"Nos voix s'unissent pour te glorifier."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Nous te donnons nos cœurs,",
				"Nous te donnons nos âmes.",
				"Oh viens par ton Esprit",
				"Raviver notre amour,",
				"Oh viens changer nos vies."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"O Seigneur souviens-toi",
				"De tes œuvres passées,",
				"De tes miracles et de tes hauts faits",
				"Et renouvelle-les",
				"En ces jours et ces années,",
				"Pour que ta gloire soit manifestée."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Nous te donnons nos cœurs,",
				"Nous te donnons nos âmes.",
				"Oh viens par ton Esprit",
				"Raviver notre amour,",
				"Oh viens changer nos vies."
			]
		}
	],
