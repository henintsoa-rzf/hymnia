{
	"id": "nous-voici-devant-ta-croix",
	"title": "Nous voici devant ta croix",
	"entries": [
		{
			"hymnal": "arc",
			"number": "454"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Nous voici devant ta croix,",
				"Devant tes souffrances,",
				"Fils de Dieu, le Roi des rois,",
				"Réduit au silence.",
				"En toi seul est notre foi",
				"Et notre assurance.",
				"Nous vivrons unis à toi ;",
				"C’est notre espérance."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Le soleil s’est obscurci",
				"Sur la terre entière ;",
				"Te voici, profonde nuit,",
				"Couvrant nos misères.",
				"Jésus remet son esprit",
				"Dans les mains du Père,",
				"Attirant tout homme à lui",
				"Dans la vraie lumière."
			]
		}
	],
