{
	"id": "o-dieu-ta-loi-est-sainte",
	"title": "O Dieu ! ta loi est sainte.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "565"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"O Dieu ! ta loi est sainte,",
				"Et ton commandement",
				"Saint, juste ! et bon.",
				"Mais, si tu comptes nos iniquités,",
				"Éternel, qui pourra subsister",
				"Devant toi ?"
			]
		}
	],
