{
	"id": "o-jesus-je-me-repose",
	"title": "O Jésus, je me repose",
	"entries": [
		{
			"hymnal": "atg",
			"number": "320"
		},
		{
			"hymnal": "adf",
			"number": "408"
		},
		{
			"hymnal": "cd",
			"number": "249"
