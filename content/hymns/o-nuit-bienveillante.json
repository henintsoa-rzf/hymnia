	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"O nuit bienveillante,",
				"O nuit rassurante,",
				"Douce nuit du premier Noël !",
				"Jésus, ô mystère,",
				"Naît sur cette terre ;",
				"Chantons, chantons à l'Éternel !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"O nuit bienveillante,",
				"O nuit rassurante,",
				"Douce nuit du premier Noël !",
				"Jésus nous délivre,",
				"Jésus nous fait vivre ;",
				"Chantons, chantons à l'Éternel !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"O nuit bienveillante,",
				"O nuit rassurante,",
				"Douce nuit du premier Noël !",
				"Qu'au saint Roi des anges",
				"Montent nos louanges ;",
				"Chantons, chantons à l'Éternel !"
			]
		}
	],
