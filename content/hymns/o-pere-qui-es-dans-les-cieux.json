{
	"id": "o-pere-qui-es-dans-les-cieux",
	"title": "O Père qui es dans les cieux",
	"entries": [
		{
			"hymnal": "arc",
			"number": "576"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"O Père qui es dans les cieux,",
				"Sur cet enfant jette les yeux ;",
				"Tu connais sa faiblesse.",
				"C’est pour lui, c’est pour son salut",
				"Que ton Fils Jésus a connu",
				"La mort et la détresse.",
				"Seigneur,",
				"Sauveur,",
				"Purifie, sanctifie, rends fidèle",
				"Cet enfant que tu appelles."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ecarte de lui toute erreur ;",
				"Mets ta vérité dans son coeur ;",
				"Viens bénir son enfance.",
				"Dans le beau combat de la foi,",
				"Que toujours appuyé sur toi,",
				"Il garde l’espérance.",
				"Seigneur,",
				"Sauveur,",
				"Purifie, sanctifie, rends fidèle",
				"Cet amour que tu appelles."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Rempli des dons de ton Esprit,",
				"Qu’en toi, Seigneur, portant du fruit,",
				"Dans ta grâce il demeure.",
				"Et que sur le chemin des cieux,",
				"Il marche toujours sous tes yeux",
				"Jusqu’à sa dernière heure.",
				"Seigneur,",
				"Sauveur,",
				"Purifie, sanctifie, renouvelle",
				"Cette vie que tu appelles."
			]
		}
	],
