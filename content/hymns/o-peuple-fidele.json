{
	"id": "o-peuple-fidele",
	"title": "O peuple fidèle",
	"entries": [
		{
			"hymnal": "atg",
			"number": "102"
		},
		{
			"hymnal": "adf",
			"number": "548"
		},
		{
			"hymnal": "cd",
			"number": "93"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"O peuple fidèle,",
				"Jésus vous appelle :",
				"Venez, triomphants, joyeux,",
				"Venez en ces lieux !",
				"O peuple fidèle,",
				"Venez voir le Roi des cieux.",
				"Que votre amour l'implore,",
				"Que votre foi l'adore",
				"Et qu'elle chante encore",
				"Ce don précieux !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quoi ! dans l'humble étable,",
				"Froide et misérable,",
				"Des bergers le grand amour",
				"Lui forme une cour !",
				"Dans cette humble étable",
				"Accourez à votre tour.",
				"Que votre amour l'implore,",
				"Que votre foi l'adore",
				"Et qu'elle chante encore",
				"Sa gloire en ce jour !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Il vient sur la terre",
				"Fléchir la colère",
				"De Dieu, notre Créateur,",
				"Sauver le pécheur.",
				"Il vient, tel un frère,",
				"Votre puissant Rédempteur.",
				"Que votre amour l'implore,",
				"Que votre foi l'adore",
				"Et qu'elle chante encore",
				"Jésus, le Sauveur !"
			]
		}
	],
