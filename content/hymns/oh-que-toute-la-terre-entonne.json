{
	"id": "oh-que-toute-la-terre-entonne",
	"title": "Oh ! que toute la terre entonne",
	"entries": [
		{
			"hymnal": "atg",
			"number": "75"
		},
		{
			"hymnal": "adf",
			"number": "534"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Oh ! que toute la terre entonne",
				"Un hymne à ton honneur !",
				"Que l'univers entier résonne",
				"De ta gloire, ô Sauveur !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ton Nom, c'est l'amour et la vie,",
				"La grâce et le pardon ;",
				"Et l'âme écoute et se confie",
				"À Toi dans l'abandon."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"O Christ, que tout genou fléchisse",
				"À ton Nom glorieux,",
				"Pour t'adorer, que tout s'unisse",
				"Sur terre et dans les cieux."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"À Toi, louange, honneur et gloire,",
				"À Ton Nom, ô Jésus !",
				"Ta croix remporte la victoire",
				"Et sauve les perdus."
			]
		}
	],
	"credits": [
