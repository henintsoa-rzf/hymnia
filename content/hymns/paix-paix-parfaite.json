	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Paix, paix parfaite",
				"En Jésus le Sauveur,",
				"Parfaite paix, même pour moi, pécheur !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Paix, paix parfaite !",
				"Où sont tous mes péchés ?",
				"Le sang de Christ les a tous effacés !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Paix, paix parfaite !",
				"Au fort de ma douleur,",
				"L'amour de Christ met la joie en mon cœur !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Paix, paix parfaite",
				"En notre Emmanuel,",
				"Paix sur la terre et gloire dans le ciel !"
			]
		}
	],
