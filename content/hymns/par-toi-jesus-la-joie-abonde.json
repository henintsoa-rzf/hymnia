{
	"id": "par-toi-jesus-la-joie-abonde",
	"title": "Par toi, Jésus, la joie abonde",
	"entries": [
		{
			"hymnal": "atg",
			"number": "158"
		},
		{
			"hymnal": "adf",
			"number": "627"
		},
		{
