{
	"id": "par-ton-sang",
	"title": "Par ton sang",
	"entries": [
		{
			"hymnal": "exo",
			"number": "13"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Par ton sang",
				"Vers toi j'avance",
				"Ceint de ta puissance",
				"Fort de ta présence",
				"À chaque pas",
				"En ton sang ma délivrance",
				"Le sceau de ton alliance",
				"Ma vie, ma révérence",
				"Devant toi"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ni mes craintes ni mes doutes",
				"Ne détourneront ma foi",
				"De ta grâce sur ma route",
				"Et de ton amour pour moi"
			]
		}
	],
