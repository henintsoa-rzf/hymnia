	"title": "Pare-nous pour cette fête",
	"entries": [
		{
			"hymnal": "arc",
			"number": "581"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Pare-nous pour cette fête",
				"Qu’aujourd’hui tu nous apprêtes.",
				"Seigneur, fais briller la terre",
				"Du secret de ta lumière.",
				"Viens nourrir notre confiance,",
				"Affermir notre espérance.",
				"Que ton pain et ta promesse",
				"Soient pour nous joie et richesse."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu prépares notre place",
				"A ce festin de ta grâce.",
				"Tu nous donnes en silence",
				"La douceur de ta présence.",
				"Reçois-nous à cette table",
				"Au repas inépuisable,",
				"Avant que tu nous appelles",
				"A tes tables éternelles."
			]
		}
	],
