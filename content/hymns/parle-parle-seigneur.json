{
	"id": "parle-parle-seigneur",
	"title": "Parle, parle Seigneur.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "188"
		},
		{
			"hymnal": "adf",
			"number": "188A"
		},
		{
			"hymnal": "adf",
			"number": "188B"
