	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Parole transcendante,",
				"Au commencement présente,",
				"Divine parole, tu es",
				"De toute éternité."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Parole immanente,",
				"Qui du ciel s’est détachée,",
				"Divine parole incarnée,",
				"De grâce et vérité."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Messager d’espérance",
				"Soumis à la souffrance,",
				"Christ porta notre honte ;",
				"En lui la grâce abonde."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Parole de lumière",
				"Qui fut envoyée du Père,",
				"Divine parole, clouée,",
				"Pour nous tu t’es humiliée."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Messager d’espérance",
				"Soumis à la souffrance,",
				"Christ porta notre honte ;",
				"En lui la grâce abonde."
			]
		},
		{
