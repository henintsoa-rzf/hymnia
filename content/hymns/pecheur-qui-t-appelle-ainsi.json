{
	"id": "pecheur-qui-t-appelle-ainsi",
	"title": "Pécheur, qui t'appelle ainsi ?",
	"entries": [
		{
			"hymnal": "adf",
			"number": "234"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Pécheur, qui t'appelle ainsi ?",
				"La voix maternelle",
				"Est moins douce : « Viens ici,",
				"Sous mon aile ! »"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Toi que le mal a meurtri",
				"Pauvre cœur rebelle,",
				"Accours ! Tu seras guéri",
				"Sous mon aile."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Car qui touche à l'un des miens",
				"Touche à ma prunelle ;",
				"Heureux celui que je tiens",
				"Sous mon aile."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Là tu verras les clartés",
				"De l'aube immortelle :",
				"Il n'est point d'obscurités",
				"Sous mon aile."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Ce trésor longtemps cherché :",
				"La vie éternelle,",
				"Tu le trouveras caché",
				"Sous mon aile !"
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"« O Jésus ! qu'à ton amour",
				"Je reste fidèle ;",
				"Garde-moi de jour en jour",
				"Sous ton aile ;"
			]
		},
		{
			"type": "verse",
			"number": 7,
			"lines": [
				"Et quand sonnera pour moi",
				"L'heure solennelle,",
				"Que je m'endorme avec toi",
				"Sous ton aile ! »"
			]
		}
	],
	"credits": [
		{
			"name": "Jane Laurie Borthwick",
			"role": "music"
		},
