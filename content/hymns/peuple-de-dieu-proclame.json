{
	"id": "peuple-de-dieu-proclame",
	"title": "Peuple de Dieu, proclame",
	"entries": [
		{
			"hymnal": "atg",
			"number": "370"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Peuple de Dieu, proclame",
				"Christ, le Seigneur !",
				"Oh ! Que sa sainte flamme",
				"Brûle en ton cœur !",
				"Chante ses grands exploits,",
				"Et porte au loin ses lois,",
				"Dis qu'il est notre Roi,",
				"Qu'il est vainqueur."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"L'œuvre est pressante et belle,",
				"Il faut agir.",
				"Dieu sans relâche appelle :",
				"Qui veut s'offrir ?",
				"Troupes du Roi, partez,",
				"Prêtes à tout quitter,",
				"À vaillamment lutter :",
				"Christ va venir !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Faites partout silence,",
				"Peuples nombreux !",
				"Notre Seigneur s'avance",
				"Du haut des cieux.",
				"Il est celui qui vient,",
				"Le sceptre d'or il tient",
				"Et va régner enfin,",
				"Roi glorieux !"
			]
		}
	],
	"credits": [
