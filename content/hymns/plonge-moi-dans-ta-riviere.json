{
	"id": "plonge-moi-dans-ta-riviere",
	"title": "Plonge-moi dans ta rivière",
	"entries": [
		{
			"hymnal": "jem",
			"number": "589"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Plonge-moi dans ta rivière d'amour,",
				"Plonge mon esprit dans",
				"Les profondeurs de ta joie.",
				"Inonde le désert de mon âme",
				"Par la douce pluie du ciel."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Mon âme est rafraîchie ;",
				"Quand ton onction m'envahit,",
				"Je suis restauré guéri,",
				"Quand ton onction m'envahit."
			]
		}
	],
