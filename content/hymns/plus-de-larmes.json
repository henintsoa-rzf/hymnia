{
	"id": "plus-de-larmes",
	"title": "Plus de larmes",
	"entries": [
		{
			"hymnal": "psalmodie",
			"number": "414"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Plus de deuil,",
				"plus de cris,",
				"plus de douleurs !",
				"Plus de larmes,",
				"plus de pleurs ;",
				"voir mon Sauveur !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Oh, viens, Seigneur ! Que ce jour sera grand,",
				"quand tu viendras nous prendre avec toi !",
				"Là, devant toi, nous serons face à face",
				"et c’est ta présence qui nous réjouira."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Oh, que ce lieu sera beau et joyeux :",
				"les larmes de nos yeux, tu enlèvera.",
				"Nos corps malades, fatigués, limités,",
				"tu les changeras : ils seront par-faits."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Nous attendons d’être au ciel avec toi,",
				"mais, dès maintenant, nous te servirons.",
				"Dieu, nous voulons, travailler pour le bien",
				"de notre prochain et de tous nos frères."
			]
		}
	],
