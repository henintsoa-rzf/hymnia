		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Pourquoi fixer le ciel ?",
				"Pourquoi pleurer sa mort ?",
				"Pourquoi pleurer ?",
				"Je sais qu’il est vivant,",
				"Il est vivant !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Sa tombe est vide,",
				"Le ciel est vide,",
				"Mais notre coeur est plein de lui,",
				"Dieu vivant,",
				"Mais notre coeur est plein de lui."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Nos mains sont vides,",
				"Nos yeux sont vides,",
				"Mais nos chemins mènent vers lui,",
				"Dieu vivant,",
				"Mais nos chemins mènent vers lui."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Longue est la route,",
				"Dure est la route,",
				"Mais notre pain parle de lui,",
				"Dieu vivant,",
				"Mais notre pain parle de lui."
			]
		}
	],
