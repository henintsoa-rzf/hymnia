	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Précieux Jésus, précieux Jésus,",
				"Tout ému devant ta croix,",
				"Précieux Jésus.",
				"J'élève mes mains et mon âme",
				"À la louange de ton nom,",
				"Précieux Jésus, précieux Jésus."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tendre Père, tendre Père,",
				"Tu as fait de nous tes enfants,",
				"Tendre Père.",
				"J'élève mes mains et mon âme",
				"À la louange de ton nom,",
				"Tendre Père, tendre Père."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Alléluia, alléluia,",
				"Alléluia, alléluia,",
				"Alléluia,",
				"J'élève mes mains et mon âme",
				"À la louange de ton nom,",
				"Alléluia, alléluia."
			]
		}
	],
