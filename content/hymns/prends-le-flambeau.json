				"Prends le flambeau,",
				"Prends le flambeau !",
				"Annonce l'Évangile à tous les malheureux,",
				"Annonce l'Évangile.",
				"Au nom de Jésus-Christ:",
				"prends le flambeau !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Allez sur la terre entière,",
				"allez porter la lumière !"
			]
		},
