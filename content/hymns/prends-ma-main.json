{
	"id": "prends-ma-main",
	"title": "Prends ma main",
	"entries": [
		{
			"hymnal": "arc",
			"number": "619"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Prends ma main dans la tienne",
				"Et qu’en tout lieu,",
				"Ta droite me soutienne,",
				"Seigneur, mon Dieu.",
				"Comment donc sans ton aide",
				"Me diriger,",
				"Si je ne te possède",
				"Dans le danger ?"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Que ta main me dispense",
				"Joie ou douleur,",
				"Paisible en ta présence,",
				"Garde mon coeur.",
				"Je ne sais qu’une chose,",
				"Moi, ton enfant :",
				"Dans ta main je repose,",
				"Calme et confiant."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Mais si l’orage gronde,",
				"Si tout m’est pris,",
				"Si la mer est profonde",
				"Et le ciel gris,",
				"Que ta voix me soutienne,",
				"Même en ce lieu ;",
				"Que ma main dans la tienne",
				"Reste, ô mon Dieu !"
			]
		}
	],
