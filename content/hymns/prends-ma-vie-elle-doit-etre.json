{
	"id": "prends-ma-vie-elle-doit-etre",
	"title": "Prends ma vie, elle doit être",
	"entries": [
		{
			"hymnal": "atg",
			"number": "285"
		},
		{
			"hymnal": "adf",
			"number": "288"
		},
		{
			"hymnal": "cd",
			"number": "225"
