{
	"id": "prince-de-paix",
	"title": "Prince de paix",
	"entries": [
		{
			"hymnal": "jem",
			"number": "301"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Prince de paix, de vie, de sagesse,",
				"Source de joie, d'amour, de tendresse,",
				"Tu remplis mes jours,",
				"Tu es là, ô Jésus, merci."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quand dans la nuit, je cherche un refuge,",
				"Quand je t'appelle, cédant à la peur,",
				"Tu m'entends, c'est toi ;",
				"Sans tarder tu m'ouvres tes bras."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Et quand la joie fait chanter ma bouche,",
				"Quand ton soleil éclaire ma route,",
				"Je te prie aussi ;",
				"Je te loue et tu me souris."
			]
		}
	],
	"credits": [
