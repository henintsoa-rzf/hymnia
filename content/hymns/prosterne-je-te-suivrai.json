{
	"id": "prosterne-je-te-suivrai",
	"title": "Prosterné (je te suivrai)",
	"entries": [
		{
			"hymnal": "jem",
			"number": "976"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Je te suivrai, Jésus,",
				"Tous les jours de ma vie, ici-bas.",
				"Je ne veux pas d'autre nom",
				"Que le tien, c'est pourquoi"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Je me tiens prosterné,",
				"Adorant devant toi, à la croix.",
				"Je me tiens prosterné,",
				"Adorant devant toi, à la croix."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Je te soumets ma vie et mes droits,",
				"Mes projets et mes choix.",
				"Je veux faire ta volonté,",
				"Ô mon Roi, c'est pourquoi"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Je me tiens prosterné,",
				"Adorant devant toi, à la croix.",
				"Je me tiens prosterné,",
				"Adorant devant toi, à la croix."
			]
		}
	],
