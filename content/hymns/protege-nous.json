	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Protège-nous sur le chemin,",
				"Conduis-nous par ta sûre main,"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Et qu'à toute heure",
				"Ta joie demeure dans nos cœurs,",
				"O Jésus !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Quand s'assombrit la nuit,",
				"Ta grâce nous suffit."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Oui, qu'à toute heure",
				"Ta joie demeure dans nos cœurs,",
				"O Jésus !"
			]
		}
	],
