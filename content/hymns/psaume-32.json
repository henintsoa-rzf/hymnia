{
	"id": "psaume-32",
	"title": "Psaume 32",
	"entries": [
		{
			"hymnal": "evangile21",
			"number": "31"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Heureux l’homme à qui Dieu pardonne",
				"Dont le péché est enlevé",
				"Devant l’orgueil qui emprisonne",
				"Mon être dépérissait"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ma faute ô Dieu j’ai confessé",
				"Je n’ai pas caché ma détresse",
				"Car tout fidèle peut prier",
				"Quand vient la sécheresse"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es un abri pour moi Seigneur",
				"Tu me gardes du danger",
				"Tu m’entoures de chants de délivrance",
				"Ô joie retrouvée",
				"Du pécheur pardonné"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Face au péché, Il avertit",
				"La destruction, la mort menacent",
				"Mais ceux qui en Dieu se confient",
				"Sont recouverts de grâce"
			]
		}
	],
