{
	"id": "qu-ils-sont-beaux-sur-les-montagnes",
	"title": "Qu'ils sont beaux sur les montagnes",
	"entries": [
		{
			"hymnal": "atg",
			"number": "372"
		},
		{
			"hymnal": "adf",
			"number": "357"
		},
		{
			"hymnal": "cd",
