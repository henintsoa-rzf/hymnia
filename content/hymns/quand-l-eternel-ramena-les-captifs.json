			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Celui qui marche en pleurant,",
				"Quand il porte la semence,",
				"Revient avec allégresse,",
				"Quand il porte ses gerbes."
			]
		},
