	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Quand vous m’invoquerez,",
				"Quand vous viendrez m’adresser vos prières,",
				"Moi je vous écouterai.",
				"Et vous m’invoquerez,",
				"Et vous viendrez m’adresser vos prières, vos prières."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Car je connais ce que j’ai formé pour vous :",
				"Projets de paix et non de malheur,",
				"Pour vous donner un avenir plein d’espérance,",
				"Une espérance, un avenir."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quand vous m’invoquerez,",
				"Quand vous viendrez m’adresser vos prières,",
				"Moi je vous exaucerai.",
				"Et vous m’invoquerez,",
				"Et vous viendrez m’adresser vos prières, vos prières."
			]
		}
	],
