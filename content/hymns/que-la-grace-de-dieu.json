{
	"id": "que-la-grace-de-dieu",
	"title": "Que la grâce de Dieu",
	"entries": [
		{
			"hymnal": "atg",
			"number": "200"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Que la grâce de Dieu soit sur toi",
				"Pour t'aider à marcher dans ses voies.",
				"Reçois tout son pardon",
				"Et sa bénédiction…",
				"Va en paix,",
				"Dans la joie,",
				"Dans l'amour."
			]
		}
	],
