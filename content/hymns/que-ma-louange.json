	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Que ma louange s'élève jusqu'à toi,",
				"Comme un parfum doux et agréable.",
				"Je veux te louer, je veux t'adorer",
				"En esprit et en vérité."
			]
		}
	],
