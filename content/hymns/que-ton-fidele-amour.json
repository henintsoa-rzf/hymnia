{
	"id": "que-ton-fidele-amour",
	"title": "Que ton fidèle amour",
	"entries": [
		{
			"hymnal": "atg",
			"number": "312"
		},
		{
			"hymnal": "adf",
			"number": "54"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Que ton fidèle amour",
				"est une grande chose,",
				"O Dieu, mon Rédempteur,",
				"mon rocher, mon Gardien !",
				"Oh ! quel puissant soutien,",
				"Oh ! quel puissant soutien,",
				"Que ce bras de ta grâce",
				"où mon cœur se repose !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Oui, je marche avec toi",
				"dans mon pèlerinage ;",
				"Autrefois j'étais seul,",
				"sans guide et sans Sauveur,",
				"Mais aujourd'hui, Seigneur,",
				"Mais aujourd'hui, Seigneur,",
				"Je poursuis avec toi",
				"mon terrestre voyage."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Bien-aimé Fils de Dieu !",
				"mon cœur, plein d'allégresse,",
				"Dans la paix de la foi,",
				"se tient sous ton regard.",
				"Oh ! quelle riche part",
				"Oh ! quelle riche part",
				"Mon âme, chaque jour,",
				"possède en ta tendresse !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Ainsi moi, ton enfant,",
				"Seigneur, devant ta face",
				"Je marche vers la gloire",
				"et la félicité !",
				"Et pour l'éternité,",
				"Et pour l'éternité,",
				"Ton amour près de toi",
				"me réserve une place."
			]
		}
	],
