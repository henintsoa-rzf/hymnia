			"hymnal": "atg",
			"number": "122"
		},
		{
			"hymnal": "adf",
			"number": "552"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Quelle douleur",
				"Saisit mon cœur !",
				"Le Fils de Dieu succombe :",
				"Jésus, mon Roi, mon Sauveur,",
				"Descend dans la tombe."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu meurs pour moi,",
				"Jésus, mon Roi,",
				"Ah ! fais que dès cette heure",
				"Je ne vive que pour toi,",
				"Qu'au monde je meure !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Que racheté",
				"Par ta bonté",
				"Je marche en ta justice,",
				"Et que dans l'éternité",
				"Mon cœur te bénisse !"
			]
		}
	],
