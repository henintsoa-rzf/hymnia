			"number": null,
			"lines": [
				"Qui donc dans le ciel",
				"est semblable à toi ?",
				"Qui est puissant comme toi,",
				"Éternel mon Roi,",
				"Qui est puissant comme toi,",
				"Éternel mon Roi ?"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu es Adonaï Jireh,",
				"En tout temps tu pourvoiras.",
				"Tu es Adonaï Raphé,",
				"Éternel, tu guériras."
			]
		},
