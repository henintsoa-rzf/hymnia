			"lines": [
				"Qui est comparable",
				"à l'Éternel, notre Dieu ?",
				"Il a sa demeure",
				"dans les lieux très hauts.",
				"Qui est comparable",
				"à l'Éternel, notre Dieu ?",
				"Il a sa demeure",
				"dans les lieux très hauts.",
				"Mais il s'abaisse pour voir",
				"le ciel et la terre."
			]
		},
