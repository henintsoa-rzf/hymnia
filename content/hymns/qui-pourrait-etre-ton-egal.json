{
	"id": "qui-pourrait-etre-ton-egal",
	"title": "Qui pourrait être ton égal",
	"entries": [
		{
			"hymnal": "jem",
			"number": "999"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"À qui pourrions-nous te comparer ?",
				"Qui pourrait être ton égal ?",
				"Pour toujours je proclamerai",
				"Ta grandeur et ta fidélité."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu es un abri, une forteresse,",
				"Un rocher solide, ma haute retraite.",
				"Tu ne connais aucune variation",
				"Dans ton amour sans condition."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Que tu es grand, oh Éternel !",
				"Dieu créateur de l'univers !",
				"Jamais, tu ne faiblis ; jamais, tu ne te lasses !",
				"Dieu sans limite, Dieu plein de grâce !",
				"Oh ! Que tu es grand !"
			]
		}
	],
