	"id": "reflet-de-dieu",
	"title": "Reflet de Dieu",
	"entries": [
		{
			"hymnal": "arc",
			"number": "891"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Reflet de Dieu sur l’univers,",
				"Brillant pour tous au long des jours,",
				"Tu restes seul notre secours,",
				"O Jésus-Christ ressuscité."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu resplendis transfiguré ;",
				"Tu mets au monde un feu de joie.",
				"Dans la ténèbre il brillera",
				"De tout l’éclat du Saint-Esprit."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Nous marcherons à ta clarté",
				"En espérant le jour promis.",
				"Vers toi s’avance un peuple uni,",
				"Vers ta lumière, ô vérité."
			]
		}
	],
