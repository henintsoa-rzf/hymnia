{
	"id": "rejouis-toi-fille-de-sion",
	"title": "Réjouis-toi, fille de Sion",
	"entries": [
		{
			"hymnal": "jem",
			"number": "592"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Réjouis-toi, fille de Sion,",
				"Pousse des cris de joie,",
				"Israël, pousse des cris d'allégresse,",
				"Fille de Jérusalem."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tous tes péchés ont été effacés,",
				"Ton ennemi chassé.",
				"Le Dieu d'Israël, Adonaï,",
				"Est venu vers toi, ne crains pas"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Réjouis-toi, fille de Sion,",
				"Pousse des cris de joie,",
				"Israël, pousse des cris d'allégresse,",
				"Fille de Jérusalem."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"En ces temps là, nous prophétiserons",
				"Sur toi, Jérusalem,",
				"Et nous te dirons, Sion, Sion,",
				"Relève tes bras, car voici ton Roi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Réjouis-toi, fille de Sion,",
				"Pousse des cris de joie,",
				"Israël, pousse des cris d'allégresse,",
				"Fille de Jérusalem."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Oui, le Seigneur est au milieu de toi",
				"Comme un héros qui sauve.",
				"Il te sauvera, il te réjouira.",
				"Il fera de toi sa plus grande joie."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Réjouis-toi, fille de Sion,",
				"Pousse des cris de joie,",
				"Israël, pousse des cris d'allégresse,",
				"Fille de Jérusalem."
			]
		}
	],
