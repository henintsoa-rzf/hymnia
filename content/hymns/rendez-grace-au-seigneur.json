			"number": 3,
			"lines": [
				"Gloire au Père et au Fils, au Saint-Esprit,…"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Car il est bon !",
				"Car éternel est son amour !"
			]
		}
