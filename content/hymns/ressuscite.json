{
	"id": "ressuscite",
	"title": "Ressuscité",
	"entries": [
		{
			"hymnal": "jem",
			"number": "883"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ils avaient scellé la pierre",
				"Et Satan en était fier.",
				"Oui, mais voilà…",
				"Même s'ils fouillent la terre,",
				"Ils ne verront que poussière,",
				"Tu n'es plus là !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es ressuscité !",
				"Vraiment ressuscité !",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Des profondeurs de l'enfer,",
				"Tu as soumis l'univers,",
				"Chef de ma foi.",
				"À la droite de ton père,",
				"Tu règnes dans la lumière",
				"En Roi des rois."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es ressuscité !",
				"Vraiment ressuscité !",
				"Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Sur le banc des accusés",
				"À ma place, tu t'es placé,",
				"Pourquoi ? pourquoi ?",
				"Tu as déchaîné mes fers,",
				"Mon tombeau n'est plus l'enfer,",
				"Je vis pour toi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es ressuscité !",
				"Vraiment ressuscité !",
				"Alléluia !"
			]
		}
	],
