{
	"id": "roi-de-majeste",
	"title": "Roi de majesté",
	"entries": [
		{
			"hymnal": "jem",
			"number": "935"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu sais que je t'aime tant,",
				"Tu sais que je désire être près de toi,",
				"Bien plus près qu'auparavant.",
				"Ces mots viennent de mon cœur,",
				"Ces mots sont bien réels.",
				"Je vis pour toi seul,",
				"Car je te suis consacré."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Roi de majesté, je n'ai qu'un désir,",
				"Être près de toi, mon Dieu,",
				"Être près de toi, mon Dieu."
			]
		},
		{
			"type": "other",
			"number": null,
			"lines": [
				"Jésus, tu es le Sauveur de mon âme",
				"Et pour toujours et toujours",
				"Je chanterai tes louanges !"
			]
		}
	],
