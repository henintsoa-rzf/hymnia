{
	"id": "romps-nous-le-pain-de-vie",
	"title": "Romps-nous le pain de vie",
	"entries": [
		{
			"hymnal": "atg",
			"number": "195"
		},
		{
			"hymnal": "adf",
			"number": "148"
		},
		{
			"hymnal": "cd",
			"number": "138"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Romps-nous le pain de vie !",
				"Que ta bonté,",
				"Seigneur nous rassasie",
				"De vérité !",
				"Amour qui nous fais vivre,",
				"Révèle-toi !",
				"Parle dans le saint Livre",
				"À notre foi !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"O toi dont la clémence",
				"Créa du pain",
				"Pour une foule immense,",
				"Mourant de faim.",
				"Vois, ton peuple se presse",
				"Autour de toi !",
				"Secours notre détresse",
				"Et notre foi !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"C'est toi le pain de vie,",
				"Verbe puissant !",
				"C'est de ta chair meurtrie,",
				"C'est de ton sang",
				"Que notre âme doit vivre…",
				"Ah ! donne-toi",
				"Par l'Esprit et le Livre",
				"À notre foi !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Tu bénis tes apôtres,",
				"Puis, à leur tour,",
				"Ils portèrent à d'autres",
				"Ton grand amour.",
				"O Parole féconde,",
				"Que notre foi",
				"T'offre à ce pauvre monde",
				"Qui meurt sans toi !"
			]
		}
	],
