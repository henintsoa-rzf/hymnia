	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Saint, saint,",
				"saint est l'Éternel des armées.",
				"Toute la terre",
				"est remplie de sa gloire. »",
				"« Saint, saint,",
				"saint est l'Éternel des armées.",
				"Toute la terre",
				"est remplie de sa gloire. »"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"L'Éternel se tient sur un trône élevé,",
				"Son manteau de gloire",
				"Remplit sa maison,",
				"Des séraphins ne cessent de crier:"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Saint, saint,",
				"saint est l'Éternel des armées.",
				"Toute la terre",
				"est remplie de sa gloire. »",
				"« Saint, saint,",
				"saint est l'Éternel des armées.",
