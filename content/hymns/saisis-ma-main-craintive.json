	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Saisis ma main craintive,",
				"Et conduis-moi ;",
				"Fais que toujours je vive",
				"Plus près de toi.",
				"Sans toi, mon tendre Père,",
				"Pour me guider,",
				"Je ne sais sur la terre",
				"Comment marcher."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Que ta main me dispense",
				"Joie ou douleur,",
				"Paisible en ta présence,",
				"Garde mon cœur ;",
				"En toi pour toute chose,",
				"Se confiant,",
				"À tes pieds se repose",
				"Ton faible enfant."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Quand la nuit la plus noire",
				"Te voilerait,",
				"Ton bras jusqu'à la gloire",
				"Me porterait,",
				"Saisis ma main craintive,",
				"Et conduis-moi :",
				"Fais que toujours je vive",
				"Plus près de toi !"
			]
		}
	],
