	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Seigneur, dirige et sanctifie",
				"Toute la vie",
				"De ces enfants.",
				"Que ta lumière,",
				"Sur leur carrière,",
				"Brille en tout temps !",
				"Que, sous ta garde et sous tes ailes,",
				"Ils soient fidèles,",
				"Forts et constants !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Soumets leur âme à l'Évangile,",
				"Au joug facile,",
				"Plein de douceur ;",
				"Fais-leur entendre",
				"L'appel si tendre",
				"De leur Sauveur ;",
				"Que pour répondre à sa promesse,",
				"Ils aient sans cesse",
				"Le même cœur !"
			]
		}
	],
