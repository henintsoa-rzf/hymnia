{
	"id": "seigneur-en-silence",
	"title": "Seigneur, en silence",
	"entries": [
		{
			"hymnal": "atg",
			"number": "211"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Seigneur, en silence",
				"Je suis devant toi,",
				"Oh ! rends ta présence",
				"Sensible à ma foi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Je ne veux connaître",
				"Aucune autre voix",
				"Que la tienne, ô Maître,",
				"Toi seul, parle-moi !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Oui, daigne m'instruire",
				"Et dis tout, Seigneur,",
				"Ce que tu dois dire",
				"À ton serviteur."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Seigneur, je t'écoute,",
				"Seigneur, instruis-moi !",
				"Montre-moi la route,",
				"Seigneur, conduis-moi."
			]
		}
	],
	"credits": [
		{
			"name": "Harold Green",
			"role": "music"
		},
		{
			"name": "Edmond Louis Budry",
			"role": "lyrics"
		}
	],
