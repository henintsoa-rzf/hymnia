			"lines": [
				"Seigneur, étends ta royauté,",
				"Au fond de mon cœur,",
				"Prends la place qui te revient",
				"Au fond de mon cœur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Ta souveraineté, ton autorité",
				"N'auront pas de fin,",
				"N'auront pas de fin,",
				"N'auront pas de fin,",
				"Tu es digne de régner."
			]
		},
