{
	"id": "seigneur-tu-fus-notre-refuge",
	"title": "Seigneur, tu fus notre refuge",
	"entries": [
		{
			"hymnal": "atg",
			"number": "17"
		},
		{
			"hymnal": "adf",
			"number": "24"
		},
		{
