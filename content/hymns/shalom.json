	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Shalom, shalom,",
				"Que la paix soit sur toi,",
				"Shalom, shalom,",
				"Et l'amour sous ton toit.",
				"Que le pain quotidien,",
				"Le travail de tes mains,",
				"Aujourd'hui et demain",
				"Soit béni du Seigneur."
			]
		},
