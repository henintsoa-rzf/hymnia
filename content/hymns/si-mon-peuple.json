{
	"id": "si-mon-peuple",
	"title": "Si mon peuple…",
	"entries": [
		{
			"hymnal": "jem",
			"number": "216"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Si mon peuple sur qui est invoqué mon nom",
				"S'humilie, prie et me cherche ;",
				"Si mon peuple, sur qui est invoqué mon nom",
				"Se détourne de ses mauvaises voies,",
				"Je l'exaucerai des cieux,",
				"J'effacerai son péché",
				"Et son pays je guérirai."
			]
		}
	],
