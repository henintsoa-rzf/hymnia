{
	"id": "source-de-tous-les-biens",
	"title": "Source de tous les biens.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "28"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Source de tous les biens",
				"où nous devons prétendre,",
				"Aimable et doux Sauveur !",
				"En mon cœur suppliant",
				"daigne aujourd'hui répandre",
				"Les dons de ta faveur,",
				"Les dons de ta faveur."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"De toutes mes langueurs,",
				"de toutes mes faiblesses",
				"Tes yeux sont les témoins ;",
				"Et du plus haut du ciel",
				"d'où Tu fais tes largesses,",
				"Tu vois tous mes besoins,",
				"Tu vois tous mes besoins."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Tu sais quels biens surtout",
				"sont les plus nécessaires",
				"À mon cœur abattu,",
				"Et combien, dans l'excès",
				"de toutes mes misères.",
				"Je suis pauvre en vertu,",
				"Je suis pauvre en vertu."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Je me tiens à tes pieds,",
				"chétif, nu, misérable,",
				"J'implore ta pitié ;",
				"Et j'attends, quoique indigne,",
				"un effort adorable",
				"De ta grande bonté,",
				"De ta grande bonté."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Daigne, daigne repaître",
				"un cœur qui ne mendie",
				"Qu'un morceau de ton pain,",
				"De ce pain tout céleste",
				"et qui seul remédie",
				"Aux rigueurs de la faim,",
				"Aux rigueurs de la faim."
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Deviens tout son amour,",
				"toute son allégresse,",
				"Tout son bien, tout son but ;",
				"Deviens toute sa gloire",
				"et toute sa tendresse,",
				"Comme tout son salut,",
				"Comme tout son salut."
			]
		}
	],
