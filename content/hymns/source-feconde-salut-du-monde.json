				"Me rend libre par la foi."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Du Christ la fête",
				"Est toujours prête,",
				"Le festin de noce est pour tous !",
				"Entrez sans crainte,",
				"De la voix sainte",
				"Écoutez l'appel si doux !"
			]
		},
