	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Source féconde,",
				"Salut du monde,",
				"Le sang de Christ est répandu.",
				"Ce divin frère,",
				"Sur le Calvaire,",
				"Est mort pour l'homme perdu."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oui, je puis croire,",
				"Oui, je veux croire",
				"Que Jésus-Christ est mort pour moi !",
				"Sa mort sanglante",
				"Et triomphante",
				"Me rend libre par la foi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"En Jésus joie !",
				"Il est la voie",
				"Qui nous mène toujours au but.",
				"Jésus pardonne,",
				"Il n'est personne",
				"Qu'Il repousse du Salut."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oui, je puis croire,",
				"Oui, je veux croire",
				"Que Jésus-Christ est mort pour moi !",
				"Sa mort sanglante",
				"Et triomphante",
				"Me rend libre par la foi."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Ame flétrie !",
				"Jésus convie",
				"Les méchants, les plus dissolus,",
				"Sa grâce immense",
				"Donne assurance",
				"Au cœur qui croit en Jésus."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Oui, je puis croire,",
				"Oui, je veux croire",
				"Que Jésus-Christ est mort pour moi !",
				"Sa mort sanglante",
