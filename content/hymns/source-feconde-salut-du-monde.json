				"Me rend libre par la foi."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Jour mémorable",
				"Pour le coupable !",
				"Sur la croix, au vil malfaiteur,",
				"Jésus pardonne !",
				"Jésus lui donne",
				"Le ciel, l'éternel bonheur !"
			]
		},
