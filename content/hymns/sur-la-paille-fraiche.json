{
	"id": "sur-la-paille-fraiche",
	"title": "Sur la paille fraîche",
	"entries": [
		{
			"hymnal": "atg",
			"number": "112"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Sur la paille fraîche",
				"Dort l'enfant si beau.",
				"Une pauvre crèche",
				"Lui sert de berceau.",
				"De l'azur céleste",
				"L'Étoile a souri",
				"À l'Enfant qui reste",
				"Si tard endormi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"La vierge Marie,",
				"Qui berce l'enfant,",
				"Regarde, attendrie,",
				"Le bébé dormant.",
				"Oh ! combien je t'aime,",
				"Jésus, mon sauveur.",
				"Toi, Maître suprême,",
				"Règne sur mon cœur."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Tu vins sur la terre",
				"Par amour pour moi",
				"Et tu fus mon frère",
				"Jusque sur la croix !",
				"Pour toi, ma prière",
				"Chante mon amour.",
				"Que dans ta lumière",
				"Je vive toujours."
			]
		}
	],
	"credits": [
