{
	"id": "sur-toi-sauveur",
	"title": "Sur toi, Sauveur.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "410"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Sur Toi, Sauveur, qui se fonde,",
				"Peut au péché résister ;",
				"L'effort du monde",
				"Pour le tenter,",
				"Est comme une onde",
				"Contre un Rocher,",
				"Est comme une onde",
				"Contre un Rocher."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Quelle est, ô Dieu ! la puissance",
				"D'un seul désir, d'un penchant !",
				"Sans vigilance,",
				"Le plus vaillant",
				"Tombe et t'offense",
				"En un moment.",
				"Tombe et t'offense",
				"En un moment."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Ton joug, Seigneur, est facile,",
				"Ah ! dans ton sein cache-moi !",
				"Dans cet asile,",
				"Exempt d'effroi,",
				"Mon cœur tranquille",
				"Vivra pour Toi.",
				"Mon cœur tranquille",
				"Vivra pour Toi."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Qu'en Toi ma paix soit parfaite ;",
				"Sois mon rocher, ô Dieu fort !",
				"Dans la tempête",
				"Deviens mon port,",
				"Et ma retraite",
				"Même en la mort !",
				"Et ma retraite",
				"Même en la mort !"
			]
		}
	],
	"credits": [
		{
			"name": "César Malan",
			"role": "music"
		},
