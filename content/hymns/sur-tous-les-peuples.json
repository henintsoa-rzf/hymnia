{
	"id": "sur-tous-les-peuples",
	"title": "Sur tous les peuples",
	"entries": [
		{
			"hymnal": "arc",
			"number": "364"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Sur tous les peuples dans la nuit",
				"Et l’ombre de la mort,",
				"Voici la lumière aujourd’hui",
				"Et la paix du Dieu fort. (bis)"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tous nos espoirs sont accomplis,",
				"Un enfant nous est né.",
				"La main de Dieu nous a bénis,",
				"Le Fils nous est donné. (bis)"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Il est sur terre et dans le ciel",
				"L’admirable à jamais,",
				"Le Dieu puissant, Père éternel,",
				"Le Prince de la paix. (bis)"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Cessons nos pleurs, chantons sans fin",
				"Sa juste vérité.",
				"Voici que monte le matin",
				"De sa fidélité. (bis)"
			]
		}
	],
