{
	"id": "ta-parole-ecriture-1",
	"title": "Ta Parole",
	"entries": [
		{
			"hymnal": "ecriture",
			"number": "1"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ta Parole, portée par l'Esprit,",
				"Te révèle et te glorifie.",
				"Que nous puissions entendre et comprendre,",
				"Ouvre nos yeux pour te contempler."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Quel sublime trésor, plus précieux que l'or,",
				"Tes paroles de vie éternelle !",
				"Œuvre par ton Esprit pour révéler le Christ.",
				"Parle-nous, nourris-nous par ta voix !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ta Parole convainc de péché",
				"Et nous change pour te ressembler.",
				"Que nos cœurs soient comme un sol fertile,",
				"Combats en nous l’incrédulité."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Ta Parole, sûre fondation,",
				"L'espérance des générations.",
				"Que nos vies soient bâties sur ce roc,",
				"Instruis-nous pour marcher dans tes voies !"
			]
		}
	],
