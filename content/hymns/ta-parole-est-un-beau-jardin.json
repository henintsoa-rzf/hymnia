{
	"id": "ta-parole-est-un-beau-jardin",
	"title": "Ta Parole est un beau jardin.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "152"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ta Parole est un beau jardin.",
				"En gerbes embaumées,",
				"J'y moissonne chaque matin,",
				"Des fleurs par Toi semées."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"J'aime ta Parole, Seigneur,",
				"Tu me donnes par elle,",
				"Richesses, lumière, bonheur,",
				"Et victoire éternelle !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Seigneur, ta Parole est pour moi",
				"La mine pleine d'ombre,",
				"Où je découvre par la foi,",
				"Des diamants sans nombre !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"J'aime ta Parole, Seigneur,",
				"Tu me donnes par elle,",
				"Richesses, lumière, bonheur,",
				"Et victoire éternelle !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Pareille à la voûte des cieux,",
				"Lumineuse et profonde,",
				"Ta Parole brille à mes yeux",
				"Dans la nuit de ce monde."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"J'aime ta Parole, Seigneur,",
				"Tu me donnes par elle,",
				"Richesses, lumière, bonheur,",
				"Et victoire éternelle !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Ta Parole est un chœur puissant",
				"Aux pures harmonies,",
				"Où, dans un hymne ravissant,",
				"Mille voix sont unies."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"J'aime ta Parole, Seigneur,",
				"Tu me donnes par elle,",
				"Richesses, lumière, bonheur,",
				"Et victoire éternelle !"
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Ta Parole est un arsenal,",
				"M'offrant pour la bataille",
				"Contre l'erreur, contre le mal,",
				"Une armure à ma taille."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"J'aime ta Parole, Seigneur,",
				"Tu me donnes par elle,",
				"Richesses, lumière, bonheur,",
				"Et victoire éternelle !"
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Par elle, un céleste aliment",
				"Renouvelle mon être :",
				"Manne divine, pur froment,",
				"Chair et sang de mon Maître !"
			]
		},
		{
			"type": "chorus",
