{
	"id": "ta-parole-seigneur",
	"title": "Ta Parole, Seigneur",
	"entries": [
		{
			"hymnal": "atg",
			"number": "179"
		},
		{
			"hymnal": "adf",
			"number": "154"
		},
		{
			"hymnal": "adf",
			"number": "154A"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ta Parole, Seigneur,",
				"est ma force et ma vie,",
				"À mes obscurs sentiers",
				"elle sert de flambeau ;",
				"Et semblable au soleil,",
				"Elle me vivifie,",
				"Éclairant tous mes pas",
				"jusqu'au seuil du tombeau."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Elle est la Vérité,",
				"la sagesse suprême ;",
				"Par elle je connais",
				"mon éternel destin.",
				"Ce fidèle miroir",
				"me dévoile à moi-même,",
				"En me montrant mon cœur,",
				"toujours au mal enclin."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Livre consolateur,",
				"inspiré par Dieu même,",
				"Mes yeux se sont ouverts",
				"à ta vive clarté ;",
				"Je comprends maintenant",
				"combien le Seigneur m'aime,",
				"Et je sais à quel prix",
				"Jésus m'a racheté."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Heureux celui qui croit",
				"la divine Parole !",
				"Heureux celui qu'enseigne",
				"et que guide l'Esprit !",
				"Heureux qui, loin du monde",
				"incrédule et frivole,",
				"S'est assis humblement",
				"aux pieds de Jésus-Christ !"
			]
		}
	],
