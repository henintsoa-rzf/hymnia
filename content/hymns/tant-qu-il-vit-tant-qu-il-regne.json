{
	"id": "tant-qu-il-vit-tant-qu-il-regne",
	"title": "Tant qu'il vit, tant qu'il règne",
	"entries": [
		{
			"hymnal": "atg",
			"number": "167"
		},
		{
			"hymnal": "adf",
			"number": "79"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tant qu'il vit, tant qu'il règne,",
				"Mon tout puissant Ami,",
				"Il n'est rien que mon âme craigne ;",
				"Je me sens à l'abri."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Qu'importe la nuit sombre,",
				"Le lion qui rugit ?",
				"Je sais que mon Berger dans l'ombre",
				"Me regarde et me suit."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Si ma route est glissante",
				"Et mon pas incertain,",
				"Je m'appuie à sa main puissante",
				"Et poursuis mon chemin."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"À toi seul je regarde,",
				"O Berger des brebis !",
				"Ton cœur m'aime et ton œil me garde :",
				"Voilà mon paradis."
			]
		}
	],
	"credits": [
		{
			"name": "Mélodie russe",
			"role": "music"
		},
