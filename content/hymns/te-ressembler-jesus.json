			"lines": [
				"Te ressembler, Jésus,",
				"C'est mon espoir suprême :",
				"Penser, agir, aimer,",
				"Toujours plus comme toi.",
				"Te ressembler Jésus,",
				"C'est mon espoir suprême.",
				"Par ton Esprit rends-moi",
				"Semblable à toi."
			]
		}
	],
