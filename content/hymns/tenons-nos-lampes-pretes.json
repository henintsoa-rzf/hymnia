{
	"id": "tenons-nos-lampes-pretes",
	"title": "Tenons nos lampes prêtes.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "136"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tenons nos lampes prêtes,",
				"Chrétiens, préparons-nous",
				"Pour l'heure où les trompettes",
				"Annonceront l'Époux."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Qu'à répondre on s'empresse,",
				"Hosanna ! Hosanna !",
				"Et qu'avec allégresse",
				"On chante : Alléluia !",
				"On chante : Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Voici déjà les anges,",
				"Avec eux les élus,",
				"Unissant leurs louanges",
				"En l'honneur de Jésus."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Qu'à répondre on s'empresse,",
				"Hosanna ! Hosanna !",
				"Et qu'avec allégresse",
				"On chante : Alléluia !",
				"On chante : Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Voici Jésus Lui-même,",
				"Puissant, victorieux !",
				"De son pur diadème",
				"L'éclat remplit les cieux."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Qu'à répondre on s'empresse,",
				"Hosanna ! Hosanna !",
				"Et qu'avec allégresse",
				"On chante : Alléluia !",
				"On chante : Alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Venez, bénis du Père,",
				"Qui m'avez attendu ;",
				"Entrez dans la lumière,",
				"Le ciel vous est rendu."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Qu'à répondre on s'empresse,",
				"Hosanna ! Hosanna !",
				"Et qu'avec allégresse",
				"On chante : Alléluia !",
				"On chante : Alléluia !"
			]
		}
	],
