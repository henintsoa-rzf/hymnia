{
	"id": "terre-chante-de-joie",
	"title": "Terre, chante de joie",
	"entries": [
		{
			"hymnal": "atg",
			"number": "97"
		},
		{
			"hymnal": "adf",
			"number": "94"
		},
		{
			"hymnal": "cd",
			"number": "86"
