{
	"id": "toi-qui-es-lumiere",
	"title": "Toi qui es lumière",
	"entries": [
		{
			"hymnal": "arc",
			"number": "318"
		}
	],
	"sections": [
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Toi qui es lumière,",
				"Toi qui es l’amour,",
				"Mets dans nos ténèbres",
				"Ton Esprit d’amour."
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Viens sur notre terre,",
				"Viens ouvrir nos coeurs,",
				"Toi qui nous libères",
				"Et nous rends meilleurs."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Le monde se traîne",
				"Et vit dans la nuit.",
				"Au coeur de nos peines",
				"Vienne ton Esprit."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Vois notre souffrance",
				"Et nos lâchetés.",
				"Donne l’espérance",
				"Aux coeurs fatigués."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Toi qui nous appelles",
				"A vivre avec toi",
				"Une vie nouvelle",
				"Fleurie de ta joie."
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Que dans ton attente",
				"Nous vivions ta paix",
				"Et que nos coeurs chantent",
				"La vie retrouvée."
			]
		}
	],
