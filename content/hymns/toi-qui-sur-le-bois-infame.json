{
	"id": "toi-qui-sur-le-bois-infame",
	"title": "Toi qui sur le bois infâme.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "593"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Toi qui, sur le bois infâme,",
				"As voulu mourir pour moi,",
				"Voici mon corps et mon âme ;",
				"Le monde en vain les réclame :",
				"Mon Sauveur, ils sont à toi,",
				"Mon Sauveur, ils sont à toi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Viens, ô Jésus, viens toi-même",
				"Vivre en moi de jour en jour :",
				"Malgré ma misère extrême,",
				"Seigneur, tu sais que je t'aime !",
				"Garde-moi dans ton amour,",
				"Garde-moi dans ton amour."
			]
		}
	],
