				"Toi, Seigneur, toi, le seul Dieu,",
				"Tu remplis le ciel et la terre.",
				"Toi, Seigneur, toi, le seul Dieu,",
				"Vois danser en nous ta lumière.",
				"Hosanna ! Hosanna au plus haut des cieux ! (bis)"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Toi seul es saint,",
				"Toi seul es Dieu.",
				"Toi seul es grand,",
				"Toi seul es Dieu."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Toi seul es bon,",
				"Toi seul es Dieu.",
				"Toi seul est vrai,",
				"Toi seul es Dieu."
			]
		}
	],
