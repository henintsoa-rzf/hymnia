	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"L’Éternel est ma force et ma joie,",
				"Il est le sujet de toutes mes louanges, eh ! eh !",
				"Il est mon berger, je ne manque de rien.",
				"Il est mon rocher, mon abri, mon seul bien.",
				"Je veux chanter, je veux chanter."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"« Toi seul, ô Jésus,",
				"Toi seul, ô Jésus,",
				"Es digne de recevoir",
				"La puissance, la louange et la gloire."
			]
		},
		{
