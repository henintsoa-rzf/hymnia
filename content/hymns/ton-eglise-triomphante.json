{
	"id": "ton-eglise-triomphante",
	"title": "Ton Église triomphante",
	"entries": [
		{
			"hymnal": "atg",
			"number": "70"
		},
		{
			"hymnal": "adf",
			"number": "31"
		},
		{
			"hymnal": "cd",
			"number": "51"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ton Église triomphante,",
				"O Saint Agneau !",
				"Dans ton ciel, d'une voix chante :",
				"Gloire à l'Agneau !",
				"À Lui le sceptre et le trône,",
				"À Lui l'encens, la couronne !",
				"Que ce chant toujours résonne :",
				"Gloire à l'Agneau !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"O merveilleuse harmonie !",
				"Devant l'Agneau",
				"Toute l'Église est unie :",
				"Gloire à l'Agneau !",
				"Rassemblés de toute race,",
				"Sauvés par la même grâce,",
				"Jamais ce chœur ne se lasse :",
				"Gloire à l'Agneau !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Rachetés, que vos louanges,",
				"Devant l'Agneau,",
				"S'unissent aux chœurs des anges :",
				"Gloire à l'Agneau !",
				"Gloire à la sainte Victime !",
				"Son sang lava notre crime,",
				"Et nous sauva de l'abîme :",
				"Gloire à l'Agneau !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Dès maintenant, sur la terre,",
				"Chantons l'Agneau !",
				"Adorons le saint mystère,",
				"Gloire à l'Agneau !",
				"Dans l'épreuve et la souffrance,",
				"Chantons la douce espérance",
				"De l'entière délivrance :",
				"Gloire à l'Agneau !"
			]
		}
	],
