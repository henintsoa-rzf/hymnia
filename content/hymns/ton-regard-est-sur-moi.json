{
	"id": "ton-regard-est-sur-moi",
	"title": "Ton regard est sur moi",
	"entries": [
		{
			"hymnal": "arc",
			"number": "618"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Ton regard est sur moi,",
				"Dieu bon, Dieu secourable,",
				"Révélant à ma foi",
				"Ton amour admirable ;",
				"Tu fais grâce au coupable",
				"Dont l’espoir est en toi.",
				"Ton regard est sur moi,",
				"Ton regard est sur moi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ton regard est sur moi,",
				"O Dieu puissant et sage,",
				"Dans le chemin étroit,",
				"Dirigeant mon voyage ;",
				"En toi je prends courage",
				"Aux heures de l’effroi.",
				"Ton regard est sur moi,",
				"Ton regard est sur moi."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Ton regard est sur moi",
				"Dans ce monde qui passe,",
				"Jusqu’au jour où, vers toi,",
				"Recueilli par ta grâce,",
				"Je pourrai voir ta face,",
				"Mon Seigneur et mon Roi.",
				"Ton regard est sur moi,",
				"Ton regard est sur moi."
			]
		}
	],
