	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Toujours content,",
				"Par la pluie ou par le beau temps,",
				"Quand c'est facile ou difficile,",
				"Sachons être contents ;",
				"Un chant joyeux,",
				"Rend gai ce qui est ennuyeux,",
				"Soyons comme dit l'Évangile",
				"Contents et joyeux."
			]
		}
	],
