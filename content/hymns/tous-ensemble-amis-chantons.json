	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tous ensemble, amis,",
				"Chantons d'un cœur joyeux :",
				"Oui, chantons, louons notre Dieu.",
				"Tous ensemble et d'un cœur joyeux,",
				"Oui, chantons, louons notre Dieu.",
				"Oui, chantons, louons notre Dieu.",
				"Oui, chantons, louons notre Dieu.",
				"Oui, chantons, louons notre Dieu.",
				"Amen, amen, alléluia !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Peuple du Seigneur,",
				"Sois ferme et vigilant ;",
				"Veille et prie : ton Maître vient.",
				"Sois fidèle, toujours fervent ;",
				"Veille et prie : ton Maître vient.",
				"Veille et prie : ton Maître vient.",
				"Veille et prie : ton Maître vient.",
				"Veille et prie : ton Maître vient.",
				"Amen, amen, alléluia !"
			]
		}
	],
