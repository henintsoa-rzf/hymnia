	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tous les rois de la terre",
				"te célébreront, ô Éternel,",
				"En entendant les paroles de ta bouche.",
				"Ils chanteront sur tes chemins,",
				"Car ta gloire est grande."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tous les rois de la terre",
				"te loueront, ô Éternel.",
				"Tous les rois de la terre",
				"te loueront, ô Éternel."
			]
		}
	],
