	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Majestueux, infiniment grand,",
				"Éternel Dieu, Dieu tout-puissant,",
				"Seigneur des cieux et de la terre,",
				"Dieu que je peux,",
				"Je peux appeler Père."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tout-Puissant est son nom,",
				"Infinie est sa grandeur,",
				"Devant lui, nous nous courbons,",
				"Il est le Roi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tout-Puissant est son nom,",
				"Infinie est sa grandeur,",
				"Devant lui nous nous courbons,",
				"Il est Seigneur."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Mon avenir est dans ses mains.",
				"Je sais qu'en lui, je ne crains rien.",
				"Mon plus cher désir,",
				"Ma volonté, c'est le servir",
				"Pour l'éternité."
			]
		},
		{
			"type": "chorus",
