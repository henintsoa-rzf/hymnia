{
	"id": "toute-arme",
	"title": "Toute arme",
	"entries": [
		{
			"hymnal": "jem",
			"number": "552"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Toute arme forgée contre toi sera brisée.",
				"La langue qui t'accusera sera jugée,",
				"Car Dieu marche avec nous,",
				"Oui, Dieu combat pour nous.",
				"Soumettez-vous donc à Dieu,",
				"Résistez au Malin",
				"Et il fuira loin de vous."
			]
		}
	],
