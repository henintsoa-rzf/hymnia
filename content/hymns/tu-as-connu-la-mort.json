			"lines": [
				"Tu as connu la mort,",
				"Tu es ressuscité",
				"Et tu reviens encor",
				"Pour nous sauver.",
				"Viens, Seigneur,",
				"Nous t’aimons.",
				"Viens, Seigneur,",
				"Nous t’attendons."
			]
		}
	],
