{
	"id": "tu-dors-dans-ce-tombeau",
	"title": "Tu dors dans ce tombeau.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "120"
		},
		{
			"hymnal": "cd",
			"number": "112"
