{
	"id": "tu-es-grand",
	"title": "Tu es grand",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1192"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"C'est toi qui réveilles le matin,",
				"Toi qui as créé la vie.",
				"Le soleil est entre tes mains,",
				"Devant toi le mal s'enfuit."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"C'est toi qui as choisi d'aimer,",
				"De guérir, de relever,",
				"De mourir et de racheter,",
				"Réparer les cœurs brisés.",
				"Il n'y a personne comme toi,",
				"Comme toi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Tu es grand, puissant,",
				"Plus grand que tous mes plans.",
				"Ton amour m'entoure",
				"Comme un grand océan"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Et tes mots sont vrais.",
				"Pour l'éternité,",
				"Je vais rester dans tes bras,",
				"La vie vient de toi."
			]
		},
