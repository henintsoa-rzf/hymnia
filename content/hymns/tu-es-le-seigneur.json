{
	"id": "tu-es-le-seigneur",
	"title": "Tu es le Seigneur",
	"entries": [
		{
			"hymnal": "jem",
			"number": "963"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu es le Seigneur, tu es le Sauveur,",
				"Aucun autre dieu n'est comme toi.",
				"À toi la puissance, l'honneur et la gloire.",
				"Reçois l'adoration !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu des nations,",
				"Seigneur des langues et des peuples,",
				"Maître du temps, Emmanuel,",
				"Dieu souverain, le Tout-Puissant,",
				"Nous t'apportons nos hommages."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Tu es l'Éternel, tu es le fidèle,",
				"Aucun autre dieu n'est comme toi.",
				"Dieu de l'univers, tu ne changes pas.",
				"Reçois l'adoration !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Dieu des nations,",
				"Seigneur des langues et des peuples,",
				"Maître du temps, Emmanuel,",
				"Dieu souverain, le Tout-Puissant,",
				"Nous t'apportons nos hommages."
			]
		}
	],
