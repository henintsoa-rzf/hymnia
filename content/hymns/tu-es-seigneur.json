	"id": "tu-es-seigneur",
	"title": "Tu es Seigneur",
	"entries": [
		{
			"hymnal": "jem",
			"number": "58"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu es Seigneur, Tu es Seigneur,",
				"Tu es digne Seigneur,",
				"De recevoir, gloire, majesté,",
				"Force, puissance et sagesse.",
				"Car par ton pouvoir tu créas tout l'univers,",
				"Par ta volonté il subsiste.",
				"À Toi seul, Seigneur, du fond de nos cœurs,",
				"Soient la louange et l'honneur."
			]
		}
	],
