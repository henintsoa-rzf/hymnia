{
	"id": "tu-lis-dans-mon-coeur",
	"title": "Tu lis dans mon cœur",
	"entries": [
		{
			"hymnal": "jem",
			"number": "888"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu lis dans mon cœur",
				"comme dans un livre ouvert.",
				"Tu couvres mon âme d'un amour sincère,",
				"Tu revêts ma vie d'un manteau",
				"de lumière et de gloire.",
				"Je crois en toi car en toi j'espère.",
				"Je crie vers toi car tu es mon Père.",
				"Je lève les yeux",
				"car les cieux sont ouverts sur moi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Et je vis pour ça,",
				"Ma prière c'est toi.",
				"Et je vis pour toi,",
				"Sois le Maître en moi.",
				"Et je vis pour ça,",
				"Sois le Maître en moi."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Façonne mon cœur à la douceur de ta voix.",
				"Affermis mon âme et fortifie ma foi.",
				"Donne à ma vie les couleurs infinies de ta loi.",
				"Je vis en toi car en toi je suis",
				"Comme le joyau pur d'une mélodie",
				"Que ton amour fait tendrement retentir sur moi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Et je vis pour ça,",
				"Ma prière c'est toi.",
				"Et je vis pour toi,",
				"Sois le Maître en moi.",
				"Et je vis pour ça,",
				"Sois le Maître en moi."
			]
		}
	],
