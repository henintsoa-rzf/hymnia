{
	"id": "tu-t-es-donne",
	"title": "Tu t'es donné",
	"entries": [
		{
			"hymnal": "jem",
			"number": "1108"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Tu t’es donné, tu t’es donné",
				"Sans rien compter, sans rien compter.",
				"Je ne peux saisir, je ne peux saisir",
				"Ce mystère infini, ce mystère infini."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Ton sang a coulé, ton sang a coulé",
				"Pour mes péchés, pour mes péchés.",
				"C’est par cette croix",
				"Que je suis libre en toi."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Je t’apporte mon offrande, ma louange.",
				"Je t’apporte ma reconnaissance."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Je t’apporte mon offrande, ma louange.",
				"Je t’apporte ma reconnaissance."
			]
		}
	],
