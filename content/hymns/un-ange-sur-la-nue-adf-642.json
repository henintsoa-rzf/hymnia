{
	"id": "un-ange-sur-la-nue-adf-642",
	"title": "Un ange sur la nue.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "642"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Un ange sur la nue,",
				"Aux bergers endormis",
				"Annonce la venue",
				"Du Rédempteur promis :",
				"« Il apporte à la terre",
				"La paix et le bonheur ;",
				"Adorez ce mystère,",
				"Allez voir le Seigneur. »"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Où Dieu vient jusqu'à nous."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Devant Sa gloire insigne",
				"Nous tremblerons d'effroi !",
				"Non, car voici le signe",
				"Qui marque votre roi :",
				"Dans une pauvre étable,",
				"Il dort, emmailloté ;",
				"Oh ! qu'il est admirable",
				"Dans son humilité."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Où Dieu vient jusqu'à nous."
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Et tandis que les anges",
				"S'envolent radieux,",
				"De leurs chants de louange",
				"Faisant vibrer les cieux,",
				"Les bergers se dépêchent",
				"Vers le Roi nouveau-né",
				"Qui sourit dans sa crèche",
				"À leurs yeux étonnés."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Où Dieu vient jusqu'à nous."
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Enfants, suivons l'exemple",
				"Des bergers à genoux.",
				"Cette crèche est le temple",
				"Où Dieu vient jusqu'à nous.",
				"O charité profonde !",
				"Le Christ, le Roi des rois",
				"Vient pour sauver le monde,",
				"En mourant sur la croix."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Cette crèche est le temple",
				"Où Dieu vient jusqu'à nous."
			]
		}
	],
