	"sections": [
		{
			"type": "other",
			"number": null,
			"lines": [
				"Venez, allons à Jésus,",
				"Nous, tous les enfants,",
				"Tous les enfants de la terre,",
				"Les petits, les grands.",
				"Il est l’ami, à chaque moment,",
				"Des noirs, des blancs, des jaun’, des bruns,",
				"le Seigneur Jésus,",
				"Il nous aime tous également."
			]
		}
	],
