		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Vers toi Seigneur,",
				"J'élève ma voix",
				"Pour t'adorer,",
				"Mon Sauveur, mon Roi.",
				"Reçois, Seigneur,",
				"Comme un doux parfum",
				"L'amour et le chant",
				"De nos cœurs reconnaissants."
			]
		}
	],
