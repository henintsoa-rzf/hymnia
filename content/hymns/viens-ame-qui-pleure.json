{
	"id": "viens-ame-qui-pleure",
	"title": "Viens, âme qui pleure.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "389"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Viens âme qui pleures,",
				"Viens à ton Sauveur ;",
				"Dans tes tristes heures,",
				"Dis-lui ta douleur…",
				"Dis tout bas ta plainte",
				"Au Seigneur Jésus…",
				"Parle-lui sans crainte,",
				"Et ne pleure plus."
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Dis tout à ce frère,",
				"À ce tendre ami,",
				"Ton épreuve amère,",
				"Ton deuil, ton souci.",
				"Il aime, Il console",
				"Les cœurs abattus ;",
				"Crois à sa parole,",
				"Et ne pleure plus !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Dis à d'autres âmes",
				"Ployant sous le faix,",
				"Que tu les réclames",
				"Pour le Dieu de paix.",
				"Calme leurs alarmes,",
				"Montre-leur Jésus ;",
				"Va sécher leur larmes,",
				"Et ne pleure plus !"
			]
		}
	],
	"credits": [
		{
			"name": "Philip-Paul Bliss",
			"role": "music"
		},
		{
