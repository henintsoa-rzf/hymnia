{
	"id": "viens-dans-mon-coeur",
	"title": "Viens dans mon cœur !",
	"entries": [
		{
			"hymnal": "atg",
			"number": "240"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Viens dans mon cœur,",
				"Oui, viens, Seigneur,",
				"Viens prendre toute la place.",
				"Dans ton amour,",
				"Viens dès ce jour,",
				"J'ai tant besoin de ta grâce !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Merci, Seigneur,",
				"Pour le bonheur,",
				"Que ton grand amour me donne.",
				"Tu m'as cherché,",
				"Tu m'as sauvé,",
				"À toi, mon cœur s'abandonne !"
			]
		}
	],
	"credits": [
		{
			"name": "Harry Dudley Clarke",
			"role": "music"
		},
		{
