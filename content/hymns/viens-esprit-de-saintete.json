				"Viens Esprit de sainteté,",
				"Viens Esprit de lumière,",
				"Viens Esprit de feu,",
				"Viens nous embraser !"
			]
		},
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Viens Esprit du Père, sois la lumière,",
				"Fais jaillir des cieux ta splendeur de gloire."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens Esprit de sainteté,",
				"Viens Esprit de lumière,",
				"Viens Esprit de feu,",
				"Viens nous embraser !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Témoin véridique, tu nous entraînes",
				"À proclamer: Christ est ressuscité !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens Esprit de sainteté,",
				"Viens Esprit de lumière,",
				"Viens Esprit de feu,",
				"Viens nous embraser !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"Viens, onction céleste, source d'eau vive,",
				"Affermis nos cœurs et guéris nos corps."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens Esprit de sainteté,",
				"Viens Esprit de lumière,",
				"Viens Esprit de feu,",
				"Viens nous embraser !"
			]
		},
		{
			"type": "verse",
			"number": 4,
			"lines": [
				"Esprit d'allégresse, joie de l'église,",
				"Fais jaillir des cœurs le chant de l'Agneau."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens Esprit de sainteté,",
				"Viens Esprit de lumière,",
				"Viens Esprit de feu,",
				"Viens nous embraser !"
			]
		},
		{
			"type": "verse",
			"number": 5,
			"lines": [
				"Fais-nous connaître l'amour du Père",
				"Et révèles-nous la face du Christ."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Viens Esprit de sainteté,",
				"Viens Esprit de lumière,",
				"Viens Esprit de feu,",
				"Viens nous embraser !"
			]
		},
		{
			"type": "verse",
			"number": 6,
			"lines": [
				"Feu qui illumine, souffle de vie,",
				"Par toi, resplendit la croix du Seigneur."
			]
		},
