	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Cette ville gémit sans fin pour sa rédemption ;",
				"Les gens courent après le bonheur.",
				"Les champs sont déjà mûrs pour la moisson ;",
				"On n'a jamais connu un temps meilleur."
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
				"Voici le jour du Seigneur !",
				"Voici l'appel de nos cœurs.",
				"Chante : « Alléluia, allélu, amen ! »",
				"Voici la terre pour le Roi !",
				"Nous proclamons notre foi.",
				"Chante : « Alléluia, allélu, amen ! »"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Nous persévérons, armée pionnière,",
				"Voyons refleurir le désert.",
				"Nous prophétisons dans une vision :",
				"Ossements desséchés, vous vivrez !"
			]
		},
		{
			"type": "chorus",
			"number": null,
			"lines": [
