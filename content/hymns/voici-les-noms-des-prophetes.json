			"lines": [
				"Voici les noms des prophètes de l’Ancien Testament :",
				"Esaïe, Jérémie",
				"Ezéchiel, Osée,",
				"Joël, Amos,",
				"Abdias, Jonas,",
				"Michée, Nahoum, Habakuk !",
				"Sophonie, Aggée, Zacharie",
				"Et le tout dernier, c’est Malachie !",
				"Et l’on recommence au début !"
			]
		}
	],
