{
	"id": "voyez-le-christ-sur-la-nue",
	"title": "Voyez le Christ sur la nue.",
	"entries": [
		{
			"hymnal": "adf",
			"number": "138"
		}
	],
	"sections": [
		{
			"type": "verse",
			"number": 1,
			"lines": [
				"Voyez le Christ sur la nue",
				"Descendre en triomphateur.",
				"Chantez ! l'aurore est venue,",
				"L'aurore d'un jour meilleur.",
				"Sur la nue, sur la nue, sur la nue",
				"Voici notre Rédempteur !"
			]
		},
		{
			"type": "verse",
			"number": 2,
			"lines": [
				"Il vient ! le monde, à sa vue,",
				"Frémit de crainte et d'effroi.",
				"Le voici ! que sa venue",
				"Est douce au cœur plein de foi !",
				"Sur la nue, sur la nue, sur la nue",
				"Voici, voici notre Roi !"
			]
		},
		{
			"type": "verse",
			"number": 3,
			"lines": [
				"De l'éclat de sa venue",
				"Le ciel même est ébloui.",
				"Chante, Église méconnue,",
				"Le jour du triomphe a lui.",
				"Sur la nue, sur la nue, sur la nue",
				"Tu vas régner avec Lui !"
			]
		}
	],
	"credits": [
