{
	"name": "hymnia",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Recueil de chants et hymnes chrétiens : design épuré et recherche avancée",
	"scripts": {
		"data": "tsx scripts/build-data.ts",
		"dev": "npm run data && vite dev",
		"build": "npm run data && vite build",
		"preview": "vite preview",
		"serve": "tsx scripts/serve-build.ts",
		"import": "tsx scripts/import/cli.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --project unit",
		"test:import": "vitest run --project import",
		"test:queries": "npm run data && vitest run --project queries",
		"test:perf": "vitest run --project perf",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"cheerio": "^1.2.0",
		"diff": "^9.0.0",
		"minisearch": "^7.2.0",
		"robots-parser": "^3.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^9.39.5",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@vite-pwa/sveltekit": "^2.0.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"magicast": "^0.5.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.12",
		"workbox-window": "^7.4.1"
	}
}
